[{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"(1) Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?[1992]","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":"[1992]- i.e., the army under the command of Abrahah al-Ashram which was accompanied by a huge elephant and came with the intention of destroying the Kaʿbah at Makkah."},{"number":6190,"text":"(2) Did He not make their plan into misguidance?[1993]","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":"[1993]- Causing them to perish."},{"number":6191,"text":"(3) And He sent against them birds in flocks,","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6192,"text":"(4) Striking them with stones of hard clay,","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6193,"text":"(5) And He made them like eaten straw.[1994]","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":"[1994]- i.e., husks which have been chewed by cattle. This event took place in the year of the Prophet's birth."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"1. N’as-tu pas vu ce que fit ton Seigneur aux compagnons de l’Éléphant ?","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6190,"text":"2. N’a-t-Il pas déjoué leurs intrigues,","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6191,"text":"3. en leur envoyant des nuées d’oiseaux,","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6192,"text":"4. qui leur lançaient des pierres argileuses ?","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6193,"text":"5. Il les rendit telles des brindilles mâchées (et recrachées.).","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":105,"name":"سُورَةُ الفِيلِ","englishName":"Al-Fil","englishNameTranslation":"The Elephant","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6189,"text":"Alam tara kaifa fa'ala rabbuka bi ashaabil feel","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6190,"text":"Alam yaj'al kai dahum fee tad leel","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6191,"text":"Wa arsala 'alaihim tairan abaabeel","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6192,"text":"Tar meehim bi hi jaaratim min sij jeel","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false},{"number":6193,"text":"Faja 'alahum ka'asfim m'akool","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":547,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
