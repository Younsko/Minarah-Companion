[{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"وَصَدَّقَ بِٱلْحُسْنَىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"وَكَذَّبَ بِٱلْحُسْنَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"وَلَسَوْفَ يَرْضَىٰ","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"(1) By the night when it covers[1937]","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":"[1937]- With darkness."},{"number":6060,"text":"(2) And [by] the day when it appears","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6061,"text":"(3) And [by] He who created the male and female,","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6062,"text":"(4) Indeed, your efforts are diverse.","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6063,"text":"(5) As for he who gives and fears Allāh","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6064,"text":"(6) And believes in the best [reward].","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6065,"text":"(7) We will ease him toward ease.","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6066,"text":"(8) But as for he who withholds and considers himself free of need","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6067,"text":"(9) And denies the best [reward],","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6068,"text":"(10) We will ease him toward difficulty.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6069,"text":"(11) And what will his wealth avail him when he falls?[1938]","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":"[1938]- i.e., when he dies or is destroyed. It can also mean when he falls into the Hellfire."},{"number":6070,"text":"(12) Indeed, [incumbent] upon Us is guidance.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6071,"text":"(13) And indeed, to us belongs the Hereafter and the first [life].","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6072,"text":"(14) So I have warned you of a Fire which is blazing.","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6073,"text":"(15) None will [enter to] burn therein except the most wretched one","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6074,"text":"(16) Who had denied and turned away.","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6075,"text":"(17) But the righteous one will avoid it –","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6076,"text":"(18) [He] who gives [from] his wealth to purify himself","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6077,"text":"(19) And not [giving] for anyone who has [done him] a favor to be rewarded[1939] –","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":"[1939]- i.e., without intending reciprocation for some benefit to himself."},{"number":6078,"text":"(20) But only seeking the face [i.e., acceptance] of his Lord, Most High.","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6079,"text":"(21) And he is going to be satisfied.","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"1. Par la nuit quand elle voile tout !","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6060,"text":"2. Par le jour quand il est dans tout son éclat !","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6061,"text":"3. Par ce qui[609] a créé le mâle et la femelle !","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":"[609] Sur la valeur de ce pronom relatif, voir la note précédente, qui renvoyait aux versets 5, 6 et 7 de la sourate Ach-Chams."},{"number":6062,"text":"4. Vos efforts sont, en vérité, (déployés) pour des desseins divers.","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6063,"text":"5. Celui qui donne (de ses biens) et qui craint (Allah),","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6064,"text":"6. Qui croit en la meilleure des récompenses,","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6065,"text":"7. Nous le mettrons sur la voie la plus facile.","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6066,"text":"8. Quant à celui qui fait preuve d’avarice, se passe (de la récompense d’Allah),","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6067,"text":"9. et refuse de croire en la meilleure des récompenses,","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6068,"text":"10. Nous le mettrons sur la voie la plus difficile.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6069,"text":"11. Ses biens ne lui seront en rien utiles quand il sera livré (au Feu).","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6070,"text":"12. À Nous incombe de guider (les hommes).","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6071,"text":"13. À Nous appartiennent la vie dans l’autre monde et la vie en ce bas monde.","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6072,"text":"14. Je vous mets en garde contre un Feu dévorant,","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6073,"text":"15. où ne brûlera que le réprouvé,","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6074,"text":"16. qui a osé démentir et s’est détourné avec dédain.","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6075,"text":"17. Il ne sera épargné qu’à l’homme pieux,","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6076,"text":"18. qui dépense de ses biens pour se purifier,","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6077,"text":"19. et ne le fait point pour rendre à quelqu’un la dette d’un bienfait,","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6078,"text":"20. mais pour être agréable à son Seigneur,[610] l’Altissime.","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":"[610] Littéralement : pour le Visage d’Allah : Wajhillah. Voir aussi le verset 272 de la sourate Al-Baqarah."},{"number":6079,"text":"21. Et il sera, assurément, satisfait.","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":92,"name":"سُورَةُ اللَّيۡلِ","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"Wallaili izaa yaghshaa","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"Wannahaari izaa tajalla","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"Wa maa khalaqaz zakara wal unthaa","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"Inna sa'yakum lashattaa","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"Fa ammaa man a'taa wattaqaa","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"Wa saddaqa bil husnaa","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"Fasanu yassiruhoo lilyusraa","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"Wa ammaa mam bakhila wastaghnaa","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"Wa kazzaba bil husnaa","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"Fasanu yassiruhoo lil'usraa","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"Wa maa yughnee 'anhu maaluhooo izaa taraddaa","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"Inna 'alainaa lal hudaa","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"Wa inna lanaa lal Aakhirata wal oolaa","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"Fa anzartukum naaran talazzaa","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"Laa yaslaahaaa illal ashqaa","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"Allazee kazzaba wa tawallaa","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"Wa sa yujannnabuhal atqaa","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"Allazee yu'tee maalahoo yatazakkaa","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"Wa maa li ahadin 'indahoo min ni'matin tujzaaa","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"Illab tighaaa'a wajhi rabbihil a 'laa","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"Wa lasawfa yardaa","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
