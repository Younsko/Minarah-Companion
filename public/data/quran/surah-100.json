[{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6148,"text":"فَٱلْمُورِيَٰتِ قَدْحًۭا","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6149,"text":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6150,"text":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6151,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6152,"text":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6153,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6154,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6155,"text":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6156,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6157,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"(1) By the racers, panting,[1967]","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":"[1967]- i.e., the horses bearing riders as they race to attack the enemy."},{"number":6148,"text":"(2) And the producers of sparks [when] striking[1968]","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":"[1968]- Their hoofs while galloping over rocky terrain."},{"number":6149,"text":"(3) And the chargers at dawn,[1969]","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":"[1969]- While the enemy is unaware."},{"number":6150,"text":"(4) Stirring up thereby [clouds of] dust,","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6151,"text":"(5) Arriving thereby in the center[1970] collectively,","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":"[1970]- i.e., penetrating into the enemy ranks during a surprise attack."},{"number":6152,"text":"(6) Indeed mankind, to his Lord, is ungrateful.","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6153,"text":"(7) And indeed, he is to that a witness.[1971]","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":"[1971]- Through his speech and his actions."},{"number":6154,"text":"(8) And indeed he is, in love of wealth, intense.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6155,"text":"(9) But does he not know that when the contents of the graves are scattered","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6156,"text":"(10) And that within the breasts is obtained,[1972]","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false,"footnotes":"[1972]- i.e., when all secrets are made known."},{"number":6157,"text":"(11) Indeed, their Lord with them, that Day, is [fully] Aware.[1973]","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false,"footnotes":"[1973]- Fully acquainted and familiar with everything about each one of them."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"1. Par les coursiers haletant,","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6148,"text":"2. faisant jaillir des étincelles (en galopant),","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6149,"text":"3. qui attaquent au petit jour,","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6150,"text":"4. et font voler la poussière (sous leurs sabots),","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6151,"text":"5. puis percent au milieu (des rangs ennemis) !","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6152,"text":"6. L’homme est, en vérité, bien ingrat envers son Seigneur.","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6153,"text":"7. Il en est d’ailleurs lui-même témoin.","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6154,"text":"8. Et certes, il porte aux biens (terrestres) un amour très intense.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6155,"text":"9. Ne sait-il donc pas que lorsque sera dispersé ce qu’il y a dans les tombes,","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6156,"text":"10. et que sera révélé ce que cachent les cœurs,","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6157,"text":"11. ce jour-là, leur Seigneur sera à leur sujet parfaitement Informé ?","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":100,"name":"سُورَةُ العَادِيَاتِ","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"Wal'aadi yaati dabha","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6148,"text":"Fal moori yaati qadha","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6149,"text":"Fal mugheeraati subha","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6150,"text":"Fa atharna bihee naq'a","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6151,"text":"Fawa satna bihee jam'a","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6152,"text":"Innal-insana lirabbihee lakanood","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6153,"text":"Wa innahu 'alaa zaalika la shaheed","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6154,"text":"Wa innahu lihubbil khairi la shadeed","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6155,"text":"Afala ya'lamu iza b'uthira ma filquboor","numberInSurah":9,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6156,"text":"Wa hussila maa fis sudoor","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false},{"number":6157,"text":"Inna rabbahum bihim yauma 'izil la khabeer","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
