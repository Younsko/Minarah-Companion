[{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"(1) When the earth is shaken with its [final] earthquake","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6140,"text":"(2) And the earth discharges its burdens[1962]","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":"[1962]- See verse 84:4."},{"number":6141,"text":"(3) And man says,[1963] \"What is [wrong] with it?\" -","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":"[1963]- In terror and amazement."},{"number":6142,"text":"(4) That Day, it will report its news","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6143,"text":"(5) Because your Lord has inspired [i.e., commanded] it.","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6144,"text":"(6) That Day, the people will depart[1964] separated [into categories] to be shown [the result of] their deeds.","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":"[1964]- From the place of Judgement to their final abode. Another interpretation is \"emerge separately\" (from the graves) ."},{"number":6145,"text":"(7) So whoever does an atom's weight[1965] of good will see it,","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":"[1965]- Or \"the weight of a small ant.\""},{"number":6146,"text":"(8) And whoever does an atom's weight of evil will see it.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"1. Lorsque la terre aura tremblé de son (plus violent) tremblement,","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6140,"text":"2. et qu’elle aura rejeté tous ses fardeaux,","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6141,"text":"3. et que l’homme aura demandé : « Qu’est-ce qu’elle a ? »","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6142,"text":"4. Ce jour-là, elle dira son histoire,","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6143,"text":"5. d’après ce que ton Seigneur lui aura ordonné.","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6144,"text":"6. Ce jour-là, les hommes sortiront par groupes épars pour répondre de leurs œuvres.[616]","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":"[616] Littéralement : pour que leurs œuvres leur soient montrées."},{"number":6145,"text":"7. Celui qui aura fait ne fût-ce que le poids d’un atome en bien, le verra ;","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6146,"text":"8. et celui qui aura fait ne fût-ce que le poids d’un atome en mal, le verra.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"Izaa zul zilatil ardu zil zaalaha","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"Wa akh rajatil ardu athqaalaha","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"Wa qaalal insaanu ma laha","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"Yawmaa izin tuhad dithu akhbaaraha","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"Bi-anna rabbaka awhaa laha","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"Yawma iziy yas durun naasu ash tatal liyuraw a'maalahum","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"Famaiy ya'mal mithqala zarratin khai raiy-yarah","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"Wa maiy-y'amal mithqala zarratin sharraiy-yarah","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
