[{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6215,"text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6216,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"(1) When the victory of Allāh has come and the conquest,[2005]","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false,"footnotes":"[2005]- The conquest of Makkah."},{"number":6215,"text":"(2) And you see the people entering into the religion of Allāh in multitudes,","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6216,"text":"(3) Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of Repentance.[2006]","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false,"footnotes":"[2006]- Refer to footnote of 2:37."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"1. Lorsque viendra le secours d’Allah (annonçant) la victoire,","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6215,"text":"2. et que tu verras les hommes entrer dans la religion d’Allah en foules,","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6216,"text":"3. rends gloire alors à ton Seigneur, célèbre Ses louanges et implore Son pardon ! Car Il est Tout Absoluteur !","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"Iza jaa-a nas rullahi walfath","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6215,"text":"Wa ra-aitan naasa yadkhuloona fee deenil laahi afwajah","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6216,"text":"Fa sab bih bihamdi rabbika was taghfir, innahu kaana tawwaaba","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
