[{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"(1) May the hands of Abū Lahab be ruined, and ruined is he.[2008]","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":"[2008]- Abū Lahab (the Prophet's uncle) , who was an enemy of Islām."},{"number":6218,"text":"(2) His wealth will not avail him or that which he gained.","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6219,"text":"(3) He will [enter to] burn in a Fire of [blazing] flame","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6220,"text":"(4) And his wife [as well] - the carrier of firewood.[2009]","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":"[2009]- She used to put thorns in the Prophet's path and slander him (ﷺ) . The word \"firewood\" was used by the Arabs to allude to slander and backbiting."},{"number":6221,"text":"(5) Around her neck is a rope of [twisted] fiber.","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"1. Que périssent les mains d’Abu Lahab, et qu’il périsse lui-même !","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6218,"text":"2. À rien ne lui serviront ses richesses ni tout ce qu’il a acquis !","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6219,"text":"3. Il brûlera dans un Feu aux flammes incandescentes,","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6220,"text":"4. ainsi que sa femme, porteuse de bois mort,","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6221,"text":"5. et portant au cou une corde de fibres tressées!","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"Tab bat yadaa abee Lahabinw-wa tabb","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"Maa aghna 'anhu maaluhu wa ma kasab","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"Sa yas laa naran zaata lahab","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"Wam ra-atuh hamma latal-hatab","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"Fee jeediha hab lum mim-masad","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
