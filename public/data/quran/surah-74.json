il":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"Qaaloo lam naku minal musalleen","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"Wa lam naku nut'imul miskeen","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"Wa kunnaa nakhoodu ma'al khaaa'ideen","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"Wa kunnaa nukazzibu bi yawmid Deen","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"Hattaaa ataanal yaqeen","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"Famaa tanfa'uhum shafaa'atush shaafi'een","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"Famaa lahum 'anittazkirati mu'rideen","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"Ka annahum humurum mustanfirah","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"Farrat min qaswarah","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"Bal yureedu kullum ri'im minhum any yu'taa suhufam munashsharah","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"Kallaa bal laa yakhaafoonal aakhirah","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"Kallaaa innahoo tazkirah","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"Fa man shaaa'a zakarah","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"Wa maa yazkuroona illaaa any yashaaa'al laah; Huwa ahlut taqwaa wa ahlul maghfirah","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
