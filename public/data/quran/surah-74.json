77,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"فَرَّتْ مِن قَسْوَرَةٍۭ","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"فَمَن شَآءَ ذَكَرَهُۥ","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"(1) O you who covers himself [with a garment],[1788]","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[1788]- Referring to the Prophet (ﷺ)."},{"number":5497,"text":"(2) Arise and warn","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5498,"text":"(3) And your Lord glorify","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5499,"text":"(4) And your clothing purify","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5500,"text":"(5) And uncleanliness[1789] avoid","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[1789]- Specifically, idols or generally, bad conduct and morals."},{"number":5501,"text":"(6) And do not confer favor to acquire more[1790]","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[1790]- An alternative meaning is \"Do not consider any favor you have conferred to be great.\""},{"number":5502,"text":"(7) But for your Lord be patient.","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5503,"text":"(8) And when the trumpet is blown,","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5504,"text":"(9) That Day will be a difficult day","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5505,"text":"(10) For the disbelievers - not easy.","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5506,"text":"(11) Leave Me with the one I created alone[1791]","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[1791]- i.e., without wealth or children. The reference is to al-Waleed bin al-Mugheerah, who after inclining toward the Qur’ān, denied it publicly in order to win the approval of the Quraysh."},{"number":5507,"text":"(12) And to whom I granted extensive wealth","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5508,"text":"(13) And children present [with him]","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5509,"text":"(14) And spread [everything] before him, easing [his life].","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5510,"text":"(15) Then he desires that I should add more.","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5511,"text":"(16) No! Indeed, he has been toward Our verses obstinate.","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5512,"text":"(17) I will cover him with arduous torment.","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5513,"text":"(18) Indeed, he thought and deliberated.[1792]","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[1792]- About what he would say concerning the Qur’ān and how he might discredit the Prophet (ﷺ)."},{"number":5514,"text":"(19) So may he be destroyed [for] how he deliberated.","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5515,"text":"(20) Then may he be destroyed [for] how he deliberated.","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5516,"text":"(21) Then he considered [again];","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5517,"text":"(22) Then he frowned and scowled;","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5518,"text":"(23) Then he turned back and was arrogant","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5519,"text":"(24) And said, \"This is not but magic imitated [from others].","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5520,"text":"(25) This is not but the word of a human being.\"","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5521,"text":"(26) I will drive him into Saqar.[1793]","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[1793]- One of the proper names of Hell."},{"number":5522,"text":"(27) And what can make you know what is Saqar?","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5523,"text":"(28) It lets nothing remain and leaves nothing [unburned],","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5524,"text":"(29) Altering [i.e., blackening] the skins.","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5525,"text":"(30) Over it are nineteen [angels].","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5526,"text":"(31) And We have not made the keepers of the Fire except angels. And We have not made their number except as a trial for those who disbelieve - that those who were given the Scripture will be convinced and those who have believed will increase in faith and those who were given the Scripture and the believers will not doubt and that those in whose hearts is disease [i.e., hypocrisy] and the disbelievers will say, \"What does Allāh intend by this as an example?\" Thus does Allāh send astray whom He wills and guide whom He wills. And none knows the soldiers of your Lord except Him. And it [i.e., mention of the Fire] is not but a reminder to humanity.","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5527,"text":"(32) No! By the moon","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5528,"text":"(33) And [by] the night when it departs","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5529,"text":"(34) And [by] the morning when it brightens,","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5530,"text":"(35) Indeed, it [i.e., the Fire] is of the greatest [afflictions]","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5531,"text":"(36) As a warning to humanity -","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5532,"text":"(37) To whoever wills among you to proceed[1794] or stay behind.","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":"[1794]- To righteousness by acceptance of the warning."},{"number":5533,"text":"(38) Every soul, for what it has earned, will be retained[1795]","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":"[1795]- i.e., subject or held responsible."},{"number":5534,"text":"(39) Except the companions of the right,[1796].","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":"[1796]- i.e., the righteous who receive their records in their right hands."},{"number":5535,"text":"(40) [Who will be] in gardens, questioning each other","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5536,"text":"(41) About the criminals,","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5537,"text":"(42) [And asking them], \"What put you into Saqar?\"","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5538,"text":"(43) They will say, \"We were not of those who prayed,","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5539,"text":"(44) Nor did we used to feed the poor.","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5540,"text":"(45) And we used to enter into vain discourse with those who engaged [in it],","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5541,"text":"(46) And we used to deny the Day of Recompense","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5542,"text":"(47) Until there came to us the certainty [i.e., death].\"","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5543,"text":"(48) So there will not benefit them the intercession of [any] intercessors.","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5544,"text":"(49) Then what is [the matter] with them that they are, from the reminder, turning away","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5545,"text":"(50) As if they were alarmed donkeys","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5546,"text":"(51) Fleeing from a lion?","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5547,"text":"(52) Rather, every person among them desires that he[1797] would be given scriptures spread about.[1798]","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":"[1797]- Instead of Muḥammad (ﷺ).\n[1798]- i.e., made public. Much of their refusal of his message was due to envy and jealousy of the Prophet (ﷺ)."},{"number":5548,"text":"(53) No! But they do not fear the Hereafter.","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5549,"text":"(54) No! Indeed, it [i.e., the Qur’ān] is a reminder","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5550,"text":"(55) Then whoever wills will remember it.","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5551,"text":"(56) And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"1. Ô toi qui te couvres (de ton manteau) !","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5497,"text":"2. Lève-toi et avertis !","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5498,"text":"3. La grandeur de ton Seigneur, exalte-la !","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5499,"text":"4. Tes vêtements, purifie-les !","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5500,"text":"5. L’idolâtrie, éloigne-t-en !","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5501,"text":"6. Ne te targue pas d’avoir beaucoup donné (en espérant en recevoir davantage en retour)","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5502,"text":"7. Pour ton Seigneur, sois patient !","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5503,"text":"8. Lorsqu’il sera soufflé dans le Cor,","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5504,"text":"9. ce sera alors (l’avènement) d’un jour très pénible,","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5505,"text":"10. nullement aisé pour les mécréants.","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5506,"text":"11. Laisse-Moi avec celui que J’ai créé esseulé,[585]","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":"[585] Il s’agit de Al-Walîd Ibn Al-Mughîrah Al-Makhzoumî qui fut du nombre des négateurs. Deux interprétations sont possibles ici : soit celle que nous avons adoptée (le mécréant a été créé solitaire et abandonné) soit la suivante : Laisse-Moi avec celui que J’ai été Seul à créer."},{"number":5507,"text":"12. (puis) à qui J’ai dispensé de larges biens,","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5508,"text":"13. des enfants toujours à ses côtés,","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5509,"text":"14. et devant qui J’ai rendu facile le chemin.","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5510,"text":"15. Livré à sa convoitise, il espère que Je lui donnerai davantage !","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5511,"text":"16. Non, il n’en sera rien. Car il rejetait Nos Signes avec une telle opiniâtreté !","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5512,"text":"17. Je l’épuiserai en lui faisant gravir les montées (les plus abruptes).","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5513,"text":"18. Il réfléchit et prit sa décision.","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5514,"text":"19. Puisse-t-il donc périr ! Quelle façon il a de décider !","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5515,"text":"20. Puisse-t-il donc encore périr ! Quelle façon il a de décider !","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5516,"text":"21. Puis il regarda (autour de lui),","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5517,"text":"22. fronça les sourcils et s’assombrit,","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5518,"text":"23. puis se détourna, dédaigneux.","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5519,"text":"24. « Ce n’est là, dit-il, que magie qui se transmet,","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5520,"text":"25. ce n’est là que parole humaine ! »","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5521,"text":"26. Je le ferai brûler dans le Feu de Saqar,","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5522,"text":"27. Et qui te fera jamais savoir ce que c’est que Saqar ?","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5523,"text":"28. (Un Feu qui) n’épargne et ne laisse rien,","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5524,"text":"29. et qui calcine la chair des hommes.","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5525,"text":"30. Dix-neuf (Anges) y montent la garde.","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5526,"text":"31. Nous n’avons désigné, comme gardiens du Feu, que des Anges. Nous ne les avons définis en nombre précis que pour éprouver les mécréants, enraciner la certitude dans les cœurs de ceux qui ont reçu le Livre et accroître la foi des croyants. Ainsi, les gens du Livre et les croyants ne seront plus dans le doute, cependant que ceux dont le cœur est rongé par le mal et les mécréants diront : «Que veut dire Allah par (ce nombre) donné en exemple ? » C’est ainsi qu’Allah égare qui Il veut et guide qui Il veut. Seul Lui Connaît les armées de ton Seigneur. Et cela n’est qu’un rappel à l’intention des humains.","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5527,"text":"32. Que oui ![586] Par la lune !","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":"[586] Littéralement : « Que non ! » Il s’agit là d’une interjection qui se produit souvent au début du serment d’Allah."},{"number":5528,"text":"33. Par la nuit quand elle se retire !","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5529,"text":"34. Et l’aurore quand elle se dévoile !","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5530,"text":"35. (Saqar) est certainement l’un des plus grands (périls),","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5531,"text":"36. un avertissement adressé aux humains,","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5532,"text":"37. et à qui, parmi vous, veut aller au-devant (des ordres de son Seigneur), ou préfère rester en arrière.","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5533,"text":"38. Chaque âme doit assumer la charge de ce qu’elle a fait,","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5534,"text":"39. excepté les gens de la dextre,","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5535,"text":"40. qui seront dans des jardins et s’interrogeront mutuellement","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5536,"text":"41. à propos des scélérats :","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5537,"text":"42. « Qu’est-ce qui vous a conduits jusqu’à Saqar ? »","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5538,"text":"43. « Nous n’étions pas du nombre de ceux qui accomplissent la prière, répondront-ils,","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5539,"text":"44. nous ne donnions pas à manger au pauvre,","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5540,"text":"45. et nous nous engagions dans des discussions futiles avec ceux qui s’y engageaient.","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5541,"text":"46. Et nous tenions pour mensonge le Jour de la Rétribution,","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5542,"text":"47. Jusqu’à ce que nous parvînt la grande certitude. »","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5543,"text":"48. L’intercession des intercesseurs ne leur sera pas utile.","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5544,"text":"49. Qu’ont-ils donc à se détourner du Rappel,","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5545,"text":"50. tels des ânes sauvages qui, dans leur panique,","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5546,"text":"51. fuient devant un lion ?","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5547,"text":"52. Chaque individu parmi eux voudrait recevoir des Feuillets (spécialement) déployés (pour lui).","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5548,"text":"53. Non ! Plutôt ils ne redoutent pas l’autre monde.","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5549,"text":"54. Non ! Ceci est un Rappel.","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5550,"text":"55. Alors, s’en souviendra qui voudra.","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null},{"number":5551,"text":"56. Mais ils ne s’en souviendront que si Allah le veut, Lui le Seul digne d’être craint, Lui le plus digne de pardonner.","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"Yaaa ayyuhal muddassir","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5497,"text":"Qum fa anzir","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5498,"text":"Wa rabbaka fakabbir","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false}