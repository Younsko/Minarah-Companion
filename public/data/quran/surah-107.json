.","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6201,"text":"(4) So woe to those who pray","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6202,"text":"(5) [But] who are heedless of their prayer[2000] -","numberInSurah":5,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":"[2000]- i.e., the hypocrites who are unconcerned if they miss prayers when no one sees them."},{"number":6203,"text":"(6) Those who make show [of their deeds]","numberInSurah":6,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6204,"text":"(7) And withhold [simple] assistance.","numberInSurah":7,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":107,"name":"سُورَةُ المَاعُونِ","englishName":"Al-Maa'un","englishNameTranslation":"Almsgiving","revelationType":"Meccan","numberOfAyahs":7,"ayahs":[{"number":6198,"text":"1. N’as-tu pas considéré celui qui tient pour mensonge la Rétribution ?","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6199,"text":"2. C’est justement lui qui rudoie l’orphelin,","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6200,"text":"3. et qui n’incite point à assurer la subsistance du pauvre.","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":549,"hizbQuarter":240,"sajda":false,"footnotes":null},{