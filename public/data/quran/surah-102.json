[{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"(1) Competition in [worldly] increase diverts you","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6170,"text":"(2) Until you visit the graveyards.[1980]","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":"[1980]- i.e., remain in them temporarily, meaning until the Day of Resurrection."},{"number":6171,"text":"(3) No! You are going to know.","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6172,"text":"(4) Then, no! You are going to know.","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6173,"text":"(5) No! If you only knew with knowledge of certainty...[1981]","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":"[1981]- The conclusion of this verse is estimated to be \"...you would not have been distracted from preparing for the Hereafter.\""},{"number":6174,"text":"(6) You will surely see the Hellfire.","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6175,"text":"(7) Then you will surely see it with the eye of certainty.[1982]","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":"[1982]- i.e., with actual eyesight."},{"number":6176,"text":"(8) Then you will surely be asked that Day about pleasure.[1983]","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":"[1983]- i.e., the comforts of worldly life and whether you were grateful to Allāh for His blessings."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"1. La ruée vers les richesses vous distrait,","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6170,"text":"2. jusqu’au bord de vos tombes.","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6171,"text":"3. Mais vous allez bientôt savoir.","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6172,"text":"4. Oui, vous allez bientôt savoir.","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6173,"text":"5. Si seulement vous pouviez savoir avec certitude,","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6174,"text":"6. Vous verriez alors l’Enfer !","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6175,"text":"7. Puis vous le verriez, de vos yeux le verriez,","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6176,"text":"8. Puis, ce jour-là, vous serez certes interrogés au sujet des plaisirs.","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"Al haaku mut takathur","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"Hatta zurtumul-maqaabir","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"Kalla sawfa ta'lamoon","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"Thumma kalla sawfa ta'lamoon","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"Kalla law ta'lamoona 'ilmal yaqeen","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"Latara-wun nal jaheem","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"Thumma latara wunnaha 'ainal yaqeen","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"Thumma latus alunna yauma-izin 'anin na'eem","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
