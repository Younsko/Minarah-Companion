[{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"وَمَا هُوَ بِٱلْهَزْلِ","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"وَأَكِيدُ كَيْدًۭا","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"(1) By the sky and the knocker","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5933,"text":"(2) And what can make you know what is the knocker?","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5934,"text":"(3) It is the piercing star[1901].","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":"[1901]- Whose light pierces through the darkness."},{"number":5935,"text":"(4) There is no soul but that it has over it a protector.","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5936,"text":"(5) So let man observe from what he was created.","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5937,"text":"(6) He was created from a fluid, ejected,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5938,"text":"(7) Emerging from between the backbone and the ribs.","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5939,"text":"(8) Indeed, He [i.e., Allāh], to return him [to life], is Able.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5940,"text":"(9) The Day when secrets will be put on trial,[1902]","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":"[1902]- i.e., exposed, examined and judged."},{"number":5941,"text":"(10) Then he [i.e., man] will have no power or any helper.","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5942,"text":"(11) By the sky which sends back[1903]","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":"[1903]- Rain, heat, sound waves, etc."},{"number":5943,"text":"(12) And [by] the earth which splits,[1904]","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":"[1904]- With plant growth or from geological rifts."},{"number":5944,"text":"(13) Indeed, it [i.e., the Qur’ān] is a decisive statement,","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5945,"text":"(14) And it is not amusement.","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5946,"text":"(15) Indeed, they are planning a plan,","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5947,"text":"(16) But I am planning a plan.","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5948,"text":"(17) So allow time for the disbelievers. Leave them awhile.[1905]","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":"[1905]- i.e., Do not be in haste for revenge, for you will see what will become of them."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"1. Par le ciel et l’étoile nocturne !","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5933,"text":"2. Et qui te fera jamais savoir ce qu’est l’étoile nocturne ?","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5934,"text":"3. L’étoile (à la lumière) pénétrante.","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5935,"text":"4. Il n’est pas d’âme qui n’ait son (Ange) gardien.","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5936,"text":"5. Que l’homme voie donc de quoi il est créé !","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5937,"text":"6. Il est créé d’une eau qui gicle,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5938,"text":"7. sortant d’entre les reins (de l’homme) et les côtes (de la femme).","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5939,"text":"8. (Allah) est certes Capable de le ressusciter.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5940,"text":"9. Le jour où les secrets seront révélés,","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5941,"text":"10. il n’aura ni force ni soutien.","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5942,"text":"11. Par le ciel qui fait revenir (régulièrement la pluie) !","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5943,"text":"12. Par la terre qui se fend (quand les graines viennent à pousser) !","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5944,"text":"13. C’est là, certes, une parole décisive,[603]","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":"[603] Cette parole, c’est le Coran."},{"number":5945,"text":"14. et non point des propos frivoles.","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5946,"text":"15. Ils rusent de leur meilleure ruse,","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5947,"text":"16. Et Je ruse de Ma meilleure ruse.","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5948,"text":"17. Accorde donc un délai aux mécréants, donne-leur répit pour quelque temps.","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"Wassamaaa'i wattaariq","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"Wa maaa adraaka mattaariq","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"Annajmus saaqib","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"In kullu nafsil lammaa 'alaihaa haafiz","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"Fal yanzuril insaanu mimma khuliq","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"Khuliqa mim maaa'in daafiq","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"Yakhruju mim bainissulbi wat taraaa'ib","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"Innahoo 'alaa raj'ihee laqaadir","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"Yawma tublas saraaa'ir","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"Famaa lahoo min quwwatinw wa laa naasir","numberInS