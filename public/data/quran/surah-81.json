[{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"فَأَيْنَ تَذْهَبُونَ","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"(1) When the sun is wrapped up [in darkness]","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5802,"text":"(2) And when the stars fall, dispersing,","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5803,"text":"(3) And when the mountains are removed","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5804,"text":"(4) And when full-term she-camels[1865] are neglected","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1865]- Those ten months pregnant and nearing delivery. This verse alludes to distraction from the most valued of possessions."},{"number":5805,"text":"(5) And when the wild beasts are gathered","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5806,"text":"(6) And when the seas are filled with flame[1866]","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1866]- Or \"when the seas have overflowed [into each other].\""},{"number":5807,"text":"(7) And when the souls are paired[1867]","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1867]- With another like soul. It can also mean \"joined\" (with their groups or sects) ."},{"number":5808,"text":"(8) And when the girl [who was] buried alive is asked","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5809,"text":"(9) For what sin she was killed","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5810,"text":"(10) And when the pages[1868] are spread [i.e., made public]","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1868]- On which are recorded the deeds of all people."},{"number":5811,"text":"(11) And when the sky is stripped away","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5812,"text":"(12) And when Hellfire is set ablaze","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5813,"text":"(13) And when Paradise is brought near,","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5814,"text":"(14) A soul will [then] know what it has brought [with it].[1869]","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1869]- i.e., all of one's deeds from worldly life, which have accompanied the soul to the Hereafter."},{"number":5815,"text":"(15) So I swear by the retreating stars -","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5816,"text":"(16) Those that run [their courses] and disappear [i.e., set]","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5817,"text":"(17) And by the night as it closes in[1870]","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1870]- An alternative meaning is \"as it departs.\""},{"number":5818,"text":"(18) And by the dawn when it breathes [i.e., stirs]","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5819,"text":"(19) [That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5820,"text":"(20) [Who is] possessed of power and with the Owner of the Throne, secure [in position],","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5821,"text":"(21) Obeyed there [in the heavens] and trustworthy.","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5822,"text":"(22) And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.[1871]","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1871]- Literally, \"possessed by jinn.\""},{"number":5823,"text":"(23) And he has already seen him [i.e., Gabriel] in the clear horizon.[1872]","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1872]- i.e., the eastern horizon, where the sun rises. See footnote to 53:6."},{"number":5824,"text":"(24) And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.[1873]","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1873]- Prophet Muḥammad (ﷺ) did not withhold that knowledge of the unseen which Allāh had revealed to him in the Qur’ān."},{"number":5825,"text":"(25) And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5826,"text":"(26) So where are you going?[1874]","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[1874]- In your denial of the Qur’ān and in your accusations against the Prophet (ﷺ) . The meaning is essentially \"Surely, you have strayed far from Allāh's path.\""},{"number":5827,"text":"(27) It is not except a reminder to the worlds","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5828,"text":"(28) For whoever wills among you to take a right course.","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5829,"text":"(29) And you do not will except that Allāh wills - Lord of the worlds.","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"1. Quand le soleil sera une sphère obscurcie,","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5802,"text":"2. que les étoiles tomberont, éteintes,","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5803,"text":"3. que les montagnes seront mises en mouvement,","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5804,"text":"4. que les chamelles en gésine seront délaissées,","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5805,"text":"5. que les bêtes sauvages seront rassemblées,","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5806,"text":"6. que les mers seront enflammées,","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5807,"text":"7. que les âmes seront réunies en couples (semblables),","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5808,"text":"8. et qu’il sera demandé à la fillette enterrée vivante","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5809,"text":"9. pour quel péché elle a été tuée,","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5810,"text":"10. quand les feuilles (du Livre des comptes) seront déployées,","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5811,"text":"11. quand le ciel sera dépouillé,","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5812,"text":"12. que l’Enfer sera attisé,","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5813,"text":"13. et le Paradis rapproché,","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5814,"text":"14. chaque âme saura alors ce qu’elle aura accompli.","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5815,"text":"15. J’en jure par les étoiles qui se meuvent,","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5816,"text":"16. qui surgissent et s’éclipsent,","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5817,"text":"17. par la nuit quand elle rampe et se répand,","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5818,"text":"18. par l’aurore quand elle respire,","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5819,"text":"19. que c’est la parole[594] d’un noble émissaire,[595]","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[594] Le Coran.\n[595] Nous traduisons ici par « émissaire » et non par « Messager » car il s’agit de l’Ange Gabriel et non du Prophète (paix et bénédiction d’Allah sur lui)."},{"number":5820,"text":"20. fort de l’estime du Détenteur du Trône,","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5821,"text":"21. écouté[596] et loyal.","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":"[596] L’Ange Gabriel est obéi des autres Anges."},{"number":5822,"text":"22. Votre compagnon n’est certes pas fou.","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5823,"text":"23. Il l’a bien vu à l’horizon où tout est clair.","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5824,"text":"24. Et ce n’est pas lui qui sera avare du mystère révélé.","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5825,"text":"25. Ce n’est nullement la parole d’un démon lapidé.","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5826,"text":"26. Qu’allez-vous donc chercher ?","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5827,"text":"27. Ce n’est là qu’un Rappel pour l’Univers,","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5828,"text":"28. pour ceux d’entre vous, qui voudraient prendre le droit chemin.","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5829,"text":"29. Or, vous ne voudrez rien qu’Allah ne veuille, Lui, le Seigneur de l’Univers.","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"Izash shamsu kuwwirat","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"Wa izan nujoomun kadarat","numberInSurah":2,"juz":30,"manzil"