[{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"وَيْلٌۭ لِّلْمُطَفِّفِينَ","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5850,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5851,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5852,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5853,"text":"لِيَوْمٍ عَظِيمٍۢ","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5854,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5855,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5856,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5857,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5858,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5859,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5860,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5861,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5862,"text":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5863,"text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5864,"text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5865,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5866,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5867,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5868,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5869,"text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5870,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5871,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5872,"text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5873,"text":"يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5874,"text":"خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5875,"text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5876,"text":"عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5877,"text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5878,"text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5879,"text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5880,"text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5881,"text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5882,"text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5883,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5884,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"(1) Woe to those who give less [than due],[1878]","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1878]- i.e., those who cheat people by giving them less than what they paid for when weighing or measuring - an amount so little as to hardly be noticed."},{"number":5850,"text":"(2) Who, when they take a measure from people, take in full.","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5851,"text":"(3) But if they give by measure or by weight to them, they cause loss.","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5852,"text":"(4) Do they not think that they will be resurrected","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5853,"text":"(5) For a tremendous Day -","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5854,"text":"(6) The Day when mankind will stand before the Lord of the worlds?","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5855,"text":"(7) No! Indeed, the record of the wicked is in sijjeen.","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5856,"text":"(8) And what can make you know what is sijjeen?","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5857,"text":"(9) It is [their destination[1879] recorded in] a register inscribed.","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1879]- The lowest depths of Hell."},{"number":5858,"text":"(10) Woe, that Day, to the deniers,","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5859,"text":"(11) Who deny the Day of Recompense.","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5860,"text":"(12) And none deny it except every sinful transgressor.","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5861,"text":"(13) When Our verses are recited to him, he says, \"Legends of the former peoples.\"","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5862,"text":"(14) No! Rather, the stain has covered their hearts of that which they were earning.[1880]","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1880]- i.e., their sins."},{"number":5863,"text":"(15) No! Indeed, from their Lord, that Day, they will be partitioned.[1881]","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1881]- i.e., they will not be able to see Him."},{"number":5864,"text":"(16) Then indeed, they will [enter and] burn in Hellfire.","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5865,"text":"(17) Then it will be said [to them], \"This is what you used to deny.\"","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5866,"text":"(18) No! Indeed, the record of the righteous is in ʿilliyyūn.","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5867,"text":"(19) And what can make you know what is ʿilliyyūn?","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5868,"text":"(20) It is [their destination[1882] recorded in] a register inscribed","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1882]- The highest elevations of Paradise."},{"number":5869,"text":"(21) Which is witnessed by those brought near [to Allāh].","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5870,"text":"(22) Indeed, the righteous will be in pleasure","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5871,"text":"(23) On adorned couches, observing.","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5872,"text":"(24) You will recognize in their faces the radiance of pleasure.","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5873,"text":"(25) They will be given to drink [pure] wine[1883] [which was] sealed.","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1883]- Which is delicious and does not intoxicate."},{"number":5874,"text":"(26) The last of it[1884] is musk. So for this let the competitors compete.","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1884]- i.e., its lingering odor."},{"number":5875,"text":"(27) And its mixture is of Tasneem,[1885]","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1885]- The highest spring in Paradise and the most favored drink of its inhabitants."},{"number":5876,"text":"(28) A spring from which those near [to Allāh] drink.","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5877,"text":"(29) Indeed, those who committed crimes used to laugh at those who believed.","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5878,"text":"(30) And when they passed by them, they would exchange derisive glances.","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5879,"text":"(31) And when they returned to their people, they would return jesting.","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5880,"text":"(32) And when they saw them, they would say, \"Indeed, those are truly lost.\"","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5881,"text":"(33) But they had not been sent as guardians over them.","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5882,"text":"(34) So Today[1886] those who believed are laughing at the disbelievers,","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[1886]- On the Day of Judgement."},{"number":5883,"text":"(35) On adorned couches, observing.","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5884,"text":"(36) Have the disbelievers [not] been rewarded [this Day] for what they used to do?","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"1. Malheur aux fraudeurs,","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5850,"text":"2. qui, lorsqu’ils font peser (ce qu’ils achètent), exigent la pleine mesure,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5851,"text":"3. mais qui, lorsqu’ils ont eux-mêmes à mesurer ou à peser (pour les autres), trichent volontiers.","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5852,"text":"4. Ceux-là ne songent-ils pas qu’ils seront ressuscités,","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5853,"text":"5. pour un terrible jour,","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5854,"text":"6. jour où les hommes se lèveront devant le Seigneur de l’Univers ?","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5855,"text":"7. Que non ! le Livre des pervers sera dans Sijjîn.","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5856,"text":"8. Et qui te fera jamais savoir ce que c’est que Sijjîn ?","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5857,"text":"9. Un Livre (où les noms des négateurs sont) définitivement inventoriés.","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5858,"text":"10. Malheur, ce jour-là, aux contradicteurs,","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5859,"text":"11. qui tiennent pour imposture le Jour de la Rétribution.","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5860,"text":"12. Or seul (l’homme pervers), livré à ses abus et à ses péchés, tient ce jour pour mensonge.","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5861,"text":"13. Quand Nos versets lui sont récités, il dit : « Ce ne sont que fables d’anciens ! »","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5862,"text":"14. Que non ! Ce sont plutôt leurs actions qui ont voilé leurs cœurs.","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5863,"text":"15. Que non ! ce jour-là, ils seront eux-mêmes privés de la vision de leur Seigneur.","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5864,"text":"16. Ils brûleront alors dans le Brasier incandescent.","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5865,"text":"17. Et il leur sera dit : « Voilà ce que vous teniez pour mensonge ! »","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5866,"text":"18. Que non ! le Livre des vertueux sera dans ‘Illiyyûn.","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5867,"text":"19. Et qui te fera jamais savoir ce que c’est que ‘Illiyyûn ?","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5868,"text":"20. Un Livre (où les noms des vertueux sont) définitivement inventoriés.","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5869,"text":"21. En seront témoins les rapprochés (d’Allah)[598]","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[598] Les Anges."},{"number":5870,"text":"22. Les vertueux seront certes dans le délice,","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5871,"text":"23. sur des couches, ils regarderont autour d’eux.","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5872,"text":"24. Sur leurs visages, tu reconnaîtras l’épanouissement dû au bien-être suprême.","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5873,"text":"25. Il leur sera servi à boire d’un nectar cacheté.","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5874,"text":"26. Son cachet sera de musc : voilà (un objectif) pour ceux qui voudraient rivaliser (de ferveur pour l’atteindre) !","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5875,"text":"27. (Et ce nectar) sera mélangé à l’eau de Tasnîm,","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5876,"text":"28. source dont boivent les privilégiés.[599]","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":"[599] Littéralement : les rapprochés. Si nous avons traduit ainsi, c’est pour qu’il n’y ait pas de confusion avec le sens du même mot utilisé au verset 21 (voir la note précédente). En effet, cette fois il ne s’agit pas des Anges mais des hommes vertueux, les hôtes éternels du Paradis."},{"number":5877,"text":"29. Ceux qui commettaient les crimes se riaient de ceux qui avaient cru.","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5878,"text":"30. Lorsqu’ils passaient à côté d’eux, (ils les toisaient et) échangeaient des clins d’œil.","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5879,"text":"31. Et quand ils retournaient chez eux, ils retournaient l’air moqueur.","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5880,"text":"32. Et quand ils les voyaient, ils disaient : « Ceux-là sont vraiment égarés ! »","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5881,"text":"33. Pourtant, nul ne les a chargés d’être leurs gardiens.","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5882,"text":"34. Mais ce jour-là, ce sera ceux qui ont cru qui riront des mécréants.","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5883,"text":"35. (Étendus) sur les couches, ils verront bien alors","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5884,"text":"36. si les mécréants n’ont pas été rétribués pour ce qu’ils faisaient !","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"Wailul lil mutaffifeen","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5850,"text":"Allazeena izak taaloo 'alan naasi yastawfoon","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5851,"text":"Wa izaa kaaloohum aw wazanoohum yukhsiroon","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5852,"text":"Alaa yazunnu ulaaa'ika annahum mab'oosoon","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5853,"text":"Li Yawmin 'Azeem","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5854,"text":"Yawma yaqoomun naasu li Rabbil 'aalameen","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5855,"text":"Kallaaa inna kitaabal fujjaari lafee Sijjeen","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5856,"text":"Wa maa adraaka maa Sijjeen","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5857,"text":"Kitaabum marqoom","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5858,"text":"Wailuny yawma'izil lil mukazzibeen","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5859,"text":"Allazeena yukazziboona bi yawmid deen","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5860,"text":"Wa maa yukazzibu biheee illaa kullu mu'tadin aseem","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5861,"text":"Izaa tutlaa'alaihi aayaatunaa qaala asaateerul awwaleen","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5862,"text":"Kallaa bal raana 'alaa quloobihim maa kaanoo yaksiboon","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5863,"text":"Kallaaa innahum 'ar Rabbihim yawma'izil lamah jooboon","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5864,"text":"Summa innahum lasaa lul jaheem","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5865,"text":"Summa yuqaalu haazal lazee kuntum bihee tukazziboon","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5866,"text":"Kallaaa inna kitaabal abraari lafee'Illiyyeen","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5867,"text":"Wa maaa adraaka maa 'Illiyyoon","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5868,"text":"Kitaabum marqoom","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5869,"text":"Yashhadu hul muqarra boon","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5870,"text":"Innal abraara lafee Na'eem","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5871,"text":"'Alal araaa'iki yanzuroon","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5872,"text":"Ta'rifu fee wujoohihim nadratan na'eem","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5873,"text":"Yusqawna mir raheeqim makhtoom","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5874,"text":"Khitaamuhoo misk; wa fee zaalika falyatanaafasil Mutanaafisoon","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5875,"text":"Wa mizaajuhoo min Tasneem","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5876,"text":"'Ainaiy yashrabu bihal muqarraboon","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5877,"text":"Innal lazeena ajramoo kaanoo minal lazeena aamanoo yadhakoon","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5878,"text":"Wa izaa marroo bihim yataghaamazoon","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5879,"text":"Wa izan qalabooo ilaaa ahlihimun qalaboo fakiheen","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5880,"text":"Wa izaa ra awhum qaalooo inna haaa'ulaaa'i ladaaal loon","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5881,"text":"Wa maaa ursiloo 'alaihim haafizeen","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5882,"text":"Fal yawmal lazeena aamanoo minal kuffaari yadhakoon","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5883,"text":"'Alal araaa'iki yanzuroon","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5884,"text":"Hal suwwibal kuffaaru maa kaanoo yaf'aloon","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
