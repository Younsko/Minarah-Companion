[{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"كِرَامًۭا كَٰتِبِينَ","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"(1) When the sky breaks apart","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5831,"text":"(2) And when the stars fall, scattering,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5832,"text":"(3) And when the seas are erupted","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5833,"text":"(4) And when the [contents of] graves are scattered [i.e., exposed],","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5834,"text":"(5) A soul will [then] know what it has put forth and kept back.","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5835,"text":"(6) O mankind, what has deceived you concerning your Lord, the Generous,","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5836,"text":"(7) Who created you, proportioned you, and balanced you?","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5837,"text":"(8) In whatever form He willed has He assembled you.","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5838,"text":"(9) No! But you deny the Recompense.","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5839,"text":"(10) And indeed, [appointed] over you are keepers,[1876]","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":"[1876]- Angels who preserve the deeds of men in records."},{"number":5840,"text":"(11) Noble and recording;","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5841,"text":"(12) They know whatever you do.","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5842,"text":"(13) Indeed, the righteous will be in pleasure,","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5843,"text":"(14) And indeed, the wicked will be in Hellfire.","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5844,"text":"(15) They will [enter to] burn therein on the Day of Recompense,","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5845,"text":"(16) And never therefrom will they be absent.","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5846,"text":"(17) And what can make you know what is the Day of Recompense?","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5847,"text":"(18) Then, what can make you know what is the Day of Recompense?","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5848,"text":"(19) It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allāh.","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"1. Quand le ciel se brisera,","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5831,"text":"2. quand les astres choiront,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5832,"text":"3. que les mers se confondront,","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5833,"text":"4. que les tombes seront renversées,","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5834,"text":"5. chaque âme saura alors ce qu’elle a déjà fait et ce qu’elle a renvoyé à plus tard.","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5835,"text":"6. Ô homme ! Qu’est-ce qui t’a donc leurré au sujet de ton Noble Seigneur","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5836,"text":"7. Qui t’a créé, t’a façonné et t’a donné des formes aussi proportionnées ?","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5837,"text":"8. Il t’a constitué dans la forme qu’Il a voulue.","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5838,"text":"9. Et pourtant, vous tenez la Rétribution pour imposture.","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5839,"text":"10. Des gardiens sont là à vous surveiller,","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5840,"text":"11. qui sont de nobles scripteurs,[597]","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":"[597] Sur le choix de ce mot, au lieu de « scribe » ou « écrivain », voir la note 105."},{"number":5841,"text":"12. sachant bien ce que vous faites.","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5842,"text":"13. Les vertueux auront droit au délice absolu.","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5843,"text":"14. Les scélérats seront en Enfer.","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5844,"text":"15. Ils y brûleront au Jour de la Rétribution,","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5845,"text":"16. et ne pourront s’y dérober.","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5846,"text":"17. Et qui te fera jamais savoir ce qu’est le Jour de la Rétribution ?","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5847,"text":"18. Et puis, qui te fera jamais savoir ce qu’est le Jour de la Rétribution ?","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null},{"number":5848,"text":"19. C’est le jour où aucune âme ne pourra rien pour une autre âme. Et la décision, ce jour-là, reviendra entière à Allah.","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"Izas samaaa'un fatarat","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"Wa izal kawaakibun tasarat","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"Wa izal bihaaru fujjirat","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"Wa izal qubooru bu'sirat","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"'Alimat nafsum maa qaddamat wa akhkharat","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"Yaaa ayyuhal insaaanu maa gharraka bi Rabbikal kareem","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"Allazee khalaqaka fasaw waaka fa'adalak","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"Feee ayye sooratim maa shaaa'a rakkabak","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"Kalla bal tukazziboona bid deen","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"Wa inna 'alaikum lahaa fizeen","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"Kiraaman kaatibeen","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"Ya'lamoona ma taf'aloon","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"Innal abraara lafee na'eem","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"Wa innal fujjaara lafee jaheem","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"Yaslawnahaa Yawmad Deen","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"Wa maa hum 'anhaa bighaaa 'ibeen","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"Wa maaa adraaka maa Yawmud Deen","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"Summa maaa adraaka maa Yawmud Deen","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"Yawma laa tamliku nafsul linafsin shai'anw walamru yawma'izil lillaah","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
