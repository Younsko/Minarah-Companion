[{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Al-Balad","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6025,"text":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6026,"text":"وَوَالِدٍۢ وَمَا وَلَدَ","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6027,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6028,"text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6029,"text":"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6030,"text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6031,"text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6032,"text":"وَلِسَانًۭا وَشَفَتَيْنِ","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6033,"text":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6034,"text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6035,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6036,"text":"فَكُّ رَقَبَةٍ","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6037,"text":"أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6038,"text":"يَتِيمًۭا ذَا مَقْرَبَةٍ","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6039,"text":"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6040,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6041,"text":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6042,"text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6043,"text":"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Al-Balad","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"(1) I swear by this city [i.e., Makkah] –","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6025,"text":"(2) And you, [O Muḥammad], are free of restriction in this city –","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6026,"text":"(3) And [by] the father[1924] and that which was born [of him],","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[1924]- Said to be Adam (upon him be peace) ."},{"number":6027,"text":"(4) We have certainly created man into hardship.","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6028,"text":"(5) Does he think that never will anyone overcome him?","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6029,"text":"(6) He says, \"I have spent wealth in abundance.\"","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6030,"text":"(7) Does he think that no one has seen him?","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6031,"text":"(8) Have We not made for him two eyes?","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6032,"text":"(9) And a tongue and two lips?","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6033,"text":"(10) And have shown him the two ways?[1925]","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[1925]- Of good and evil."},{"number":6034,"text":"(11) But he has not broken through the difficult pass.[1926]","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[1926]- i.e., the steep incline or obstacle. In other words, he has not spent in the cause of Allāh but only boasts of spending in front of others."},{"number":6035,"text":"(12) And what can make you know what is [breaking through] the difficult pass?","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6036,"text":"(13) It is the freeing of a slave","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6037,"text":"(14) Or feeding on a day of severe hunger","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6038,"text":"(15) An orphan of near relationship","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6039,"text":"(16) Or a needy person in misery","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6040,"text":"(17) And then being among those who believed and advised one another to patience and advised one another to compassion.","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6041,"text":"(18) Those are the companions of the right.[1927]","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[1927]- Or \"the companions of good fortune,\" i.e., those who receive their records in their right hands and proceed to Paradise."},{"number":6042,"text":"(19) But they who disbelieved in Our signs - those are the companions of the left.[1928]","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[1928]- Or \"the companions of ill fortune,\" i.e., those who receive their records in their left hands and proceed to Hell."},{"number":6043,"text":"(20) Over them will be fire closed in.[1929]","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[1929]- The cover over Hell will be sealed and locked, containing its fire and its inhabitants."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Al-Balad","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"1. J’en jure par cette cité,[605]","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[605] La Mecque."},{"number":6025,"text":"2. où il t’est licite (de combattre tes ennemis) !","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6026,"text":"3. Par le primogéniteur[606] et ce qu’il a engendré !","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[606] L’une des interprétations de cette expression coranique est, justement: Adam et ses descendants."},{"number":6027,"text":"4. Nous avons certes créé l’homme livré à l’adversité.","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6028,"text":"5. S’imagine-t-il que personne ne pourra rien contre lui ?","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6029,"text":"6. « J’ai prodigué, dit-il, une énorme fortune. »","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6030,"text":"7. Croit-il donc que personne ne l’a vu ?","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6031,"text":"8. Ne lui avons-Nous pas donné deux yeux,","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6032,"text":"9. une langue et deux lèvres ?","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6033,"text":"10. Ne lui avons-Nous pas montré les deux voies ?","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6034,"text":"11. Or, il n’a pas osé affronter la voie pentue.[607]","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":"[607] La voie pentue est l’une des deux voies, la plus facile étant celle du mal, et la plus difficile étant celle du bien."},{"number":6035,"text":"12. Et qui te fera jamais savoir ce qu’est la voie pentue ?","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6036,"text":"13. C’est affranchir un esclave,","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6037,"text":"14. ou donner à manger, en un jour de disette,","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6038,"text":"15. à un orphelin de la proche famille,","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6039,"text":"16. ou à un pauvre hère qui couche à même la terre.","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6040,"text":"17. (C’est aussi être de) ceux qui croient, se recommandent mutuellement la patience, et se recommandent mutuellement la commisération.","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6041,"text":"18. Ceux-là sont les gens de la dextre.","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6042,"text":"19. Quant à ceux qui ont nié Nos Signes, ce sont les gens de la senestre.","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6043,"text":"20. Sur eux (de toutes parts) se refermera le Feu (de la Géhenne).","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Al-Balad","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"Laaa uqsimu bihaazal balad","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6025,"text":"Wa anta hillum bihaazal balad","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6026,"text":"Wa waalidinw wa maa walad","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6027,"text":"Laqad khalaqnal insaana fee kabad","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6028,"text":"Ayahsabu al-lai yaqdira 'alaihi ahad","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6029,"text":"Yaqoolu ahlaktu maalal lubadaa","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6030,"text":"Ayahsabu al lam yarahooo ahad","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6031,"text":"Alam naj'al lahoo 'aynayn","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6032,"text":"Wa lisaananw wa shafatayn","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6033,"text":"Wa hadaynaahun najdayn","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6034,"text":"Falaq tahamal-'aqabah","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6035,"text":"Wa maaa adraaka mal'aqabah","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6036,"text":"Fakku raqabah","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6037,"text":"Aw it'aamun fee yawmin zee masghabah","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6038,"text":"Yateeman zaa maqrabah","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6039,"text":"Aw miskeenan zaa matrabah","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6040,"text":"Summa kaana minal lazeena aamanoo wa tawaasaw bissabri wa tawaasaw bilmarhamah","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6041,"text":"Ulaaa'ika As-haabul maimanah","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6042,"text":"Wallazeena kafaroo bi aayaatinaa hum as-haabul Mash'amah","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6043,"text":"Alaihim naarum mu'sadah","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
