[{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"وَٱلشَّمْسِ وَضُحَىٰهَا","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"وَنَفْسٍۢ وَمَا سَوَّىٰهَا","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"وَقَدْ خَابَ مَن دَسَّىٰهَا","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"وَلَا يَخَافُ عُقْبَٰهَا","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"(1) By the sun and its brightness","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6045,"text":"(2) And [by] the moon when it follows it","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6046,"text":"(3) And [by] the day when it displays it[1931]","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":"[1931]- The earth. Also interpreted as the sun. The same applies to the following verse."},{"number":6047,"text":"(4) And [by] the night when it covers [i.e., conceals] it","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6048,"text":"(5) And [by] the sky and He who constructed it","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6049,"text":"(6) And [by] the earth and He who spread it","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6050,"text":"(7) And [by] the soul and He who proportioned it[1932]","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":"[1932]- i.e., balanced and refined it, creating in it sound tendencies and consciousness."},{"number":6051,"text":"(8) And inspired it [with discernment of] its wickedness and its righteousness,","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6052,"text":"(9) He has succeeded who purifies it,","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6053,"text":"(10) And he has failed who instills it [with corruption].","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6054,"text":"(11) Thamūd denied [their prophet] by reason of their transgression,","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6055,"text":"(12) When the most wretched of them was sent forth.[1933]","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":"[1933]- To hamstring the she-camel which had been sent by Allāh as a sign to them."},{"number":6056,"text":"(13) And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6057,"text":"(14) But they denied him and hamstrung[1934] her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":"[1934]- And then killed."},{"number":6058,"text":"(15) And He does not fear the consequence thereof.[1935]","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":"[1935]- Allāh is not asked about what He does, but His servants will be asked. See 21:23."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"1. Par le soleil et sa clarté !","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6045,"text":"2. Par la lune quand elle le suit !","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6046,"text":"3. Par le jour quand il en montre tout l’éclat !","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6047,"text":"4. Par la nuit quand elle le voile !","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6048,"text":"5. Par le ciel et ce qui[608] l’a bâti !","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":"[608] Deux interprétations sont possibles : le pronom relatif renvoie ici soit au Créateur soit à la création. On peut faire la même remarque à propos des versets 6 et 7."},{"number":6049,"text":"6. Par la terre et ce qui l’a étendue !","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6050,"text":"7. Par l’âme et ce qui l’a si harmonieusement formée,","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6051,"text":"8. lui suggérant sa perversion ou sa piété !","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6052,"text":"9. Heureux sera, assurément, celui qui la purifie,","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6053,"text":"10. et perdu sera celui qui la souille.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6054,"text":"11. Les Thamûd ont crié au mensonge, emportés par leur transgression,","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6055,"text":"12. lorsque (pour tuer la chamelle) surgit le plus maudit d’entre eux.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6056,"text":"13. Le Messager d’Allah leur avait dit : « C’est la chamelle d’Allah, laissez-la donc s’abreuver! »","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6057,"text":"14. Mais ils le traitèrent de menteur et la tuèrent. Leur Seigneur sévit contre eux (les punissant) de leur péché et Il les châtia tous d’un égal supplice.","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null},{"number":6058,"text":"15. Et Il n’en craint pas les conséquences.","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sou