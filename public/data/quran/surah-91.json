ahi wa suqiyaahaa","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"Fakazzaboohu fa'aqaroohaa fadamdama 'alaihim Rabbuhum bizambihim fasaw waahaa","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"Wa laa yakhaafu'uqbaahaa","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
