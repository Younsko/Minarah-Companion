[{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"وَٱلنَّٰزِعَٰتِ غَرْقًۭا","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5714,"text":"وَٱلنَّٰشِطَٰتِ نَشْطًۭا","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5715,"text":"وَٱلسَّٰبِحَٰتِ سَبْحًۭا","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"فَٱلسَّٰبِقَٰتِ سَبْقًۭا","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًۭا","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"أَبْصَٰرُهَا خَٰشِعَةٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"فَكَذَّبَ وَعَصَىٰ","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"فَحَشَرَ فَنَادَىٰ","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"فَأَمَّا مَن طَغَىٰ","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5753,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5754,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5755,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5756,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"(1) By those [angels] who extract with violence[1833]","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1833]- i.e., those who tear out the souls of those destined for Hell."},{"number":5714,"text":"(2) And [by] those who remove with ease[1834]","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1834]- i.e., those angels who ease out the souls of those destined for Paradise."},{"number":5715,"text":"(3) And [by] those who glide [as if] swimming[1835]","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1835]- Speeding to execute Allāh's commands."},{"number":5716,"text":"(4) And those who race each other in a race[1836]","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1836]- Racing to deliver the souls of the believers to Paradise."},{"number":5717,"text":"(5) And those who arrange [each] matter,[1837]","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1837]- According to Allāh's decree."},{"number":5718,"text":"(6) On the Day the blast [of the Horn] will convulse [creation],","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5719,"text":"(7) There will follow it the subsequent [one].","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5720,"text":"(8) Hearts,[1838] that Day, will tremble,","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1838]- Those of the disbelievers who denied the Resurrection."},{"number":5721,"text":"(9) Their eyes[1839] humbled.","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1839]- Those of the disbelievers."},{"number":5722,"text":"(10) They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5723,"text":"(11) Even if we should be decayed bones?\"[1840]","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1840]- The disbelievers say this in ridicule of the warning."},{"number":5724,"text":"(12) They say, \"That, then, would be a losing return.\"[1841]","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1841]- i.e., \"If that were so, we would not be able to escape punishment.\""},{"number":5725,"text":"(13) Indeed, it will be but one shout,","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5726,"text":"(14) And suddenly they will be [alert] upon the earth's surface.","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5727,"text":"(15) Has there reached you the story of Moses? -","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5728,"text":"(16) When his Lord called to him in the sacred valley of Ṭuwā,","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5729,"text":"(17) \"Go to Pharaoh. Indeed, he has transgressed.","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5730,"text":"(18) And say to him, 'Would you [be willing to] purify yourself","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5731,"text":"(19) And let me guide you to your Lord so you would fear [Him]?'\"","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5732,"text":"(20) And he showed him the greatest sign,[1842]","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1842]- i.e., the miracle of his staff becoming a great snake."},{"number":5733,"text":"(21) But he [i.e., Pharaoh] denied and disobeyed.","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5734,"text":"(22) Then he turned his back, striving [i.e., plotting].[1843]","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1843]- An alternative meaning is \"running [from the snake].\""},{"number":5735,"text":"(23) And he gathered [his people] and called out","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5736,"text":"(24) And said, \"I am your most exalted lord.\"","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5737,"text":"(25) So Allāh seized him in exemplary punishment for the last and the first [transgression].[1844].","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":"[1844]- i.e., for Pharaoh's setting himself up as a deity and for his previous oppression of the people and denial of Moses."},{"number":5738,"text":"(26) Indeed in that is a lesson [i.e., warning] for whoever would fear [Allāh].","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5739,"text":"(27) Are you a more difficult creation or is the heaven? He [i.e., Allāh] constructed it.","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5740,"text":"(28) He raised its ceiling and proportioned it.","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5741,"text":"(29) And He darkened its night and extracted its brightness.[1845]","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1845]- i.e., created the day from within the surrounding darkness."},{"number":5742,"text":"(30) And after that He spread the earth.","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5743,"text":"(31) He extracted from it its water and its pasture,","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5744,"text":"(32) And the mountains He set firmly","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5745,"text":"(33) As enjoyment [i.e., provision] for you and your grazing livestock.","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5746,"text":"(34) But when there comes the greatest Overwhelming Calamity[1846] -","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1846]- i.e., the Day of Resurrection."},{"number":5747,"text":"(35) The Day when man will remember that for which he strove,","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5748,"text":"(36) And Hellfire will be exposed for [all] those who see -","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5749,"text":"(37) So as for he who transgressed","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5750,"text":"(38) And preferred the life of the world,","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5751,"text":"(39) Then indeed, Hellfire will be [his] refuge.","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5752,"text":"(40) But as for he who feared the position of his Lord[1847] and prevented the soul from [unlawful] inclination,","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1847]- See footnote to 55:46."},{"number":5753,"text":"(41) Then indeed, Paradise will be [his] refuge.","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5754,"text":"(42) They ask you, [O Muḥammad], about the Hour: when is its arrival?[1848]","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1848]- Literally, \"resting\" or \"establishment.\""},{"number":5755,"text":"(43) In what [position] are you that you should mention it?[1849]","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1849]- Meaning that Muḥammad (ﷺ) had no knowledge of it, so how could he inform them?"},{"number":5756,"text":"(44) To your Lord is its finality.[1850]","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1850]- i.e., its destination and termination. And to Him belongs ultimate knowledge of it."},{"number":5757,"text":"(45) You are only a warner for those who fear it.","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5758,"text":"(46) It will be, on the Day they see it,[1851] as though they had not remained [in the world] except for an afternoon or a morning thereof.","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":"[1851]- i.e., the Hour, the Resurrection."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"1. Par les arracheurs (des âmes) avec violence !","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5714,"text":"2. Et par ceux qui les cueillent avec douceur !","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5715,"text":"3. Par ceux qui naviguent librement,","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5716,"text":"4. puis courent et devancent,","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5717,"text":"5. pour mieux gérer les affaires !","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5718,"text":"6. Le jour où retentira (le premier son du Cor),","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5719,"text":"7. et que suivra le second (son du Cor),","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5720,"text":"8. des cœurs, ce jour-là, seront saisis de frayeur,","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5721,"text":"9. et des regards saisis d’humilité.","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5722,"text":"10. « Serons-nous donc, demanderont-ils, ramenés à notre vie sur terre,","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5723,"text":"11. alors même que nous ne serons plus qu’ossements rongés? »","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5724,"text":"12. « Ce serait donc, diront-ils, un retour où nous serions perdants ! »","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5725,"text":"13. Il n’y aura qu’un seul Cri,","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5726,"text":"14. et les voilà tous qui se réveillent à la surface de la terre !","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5727,"text":"15. L’histoire de Moïse t’est-elle parvenue ?","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5728,"text":"16. Son Seigneur l’appela dans la vallée sacrée de Touwâ en lui disant :","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5729,"text":"17. « Va trouver Pharaon, car il a transgressé !","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5730,"text":"18. Dis-lui : “Ne voudrais-tu pas te purifier","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5731,"text":"19. et me laisser te guider vers ton Seigneur que tu craindras alors ?” »","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5732,"text":"20. (Moïse) fit voir (à Pharaon) le plus grand prodige.","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5733,"text":"21. Mais celui-ci le tint pour mensonge et désobéit (à Allah),","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5734,"text":"22. puis se détourna persistant dans la mécréance.","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5735,"text":"23. Il rassembla (les siens) et fit cette déclaration :","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5736,"text":"24. « Je suis votre seigneur le plus haut ! »","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5737,"text":"25. Allah sévit contre lui par le supplice exemplaire de l’autre monde et de la vie ici-bas.","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5738,"text":"26. Il y a certes là une leçon à méditer par quiconque craint (Allah).","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5739,"text":"27. Êtes-vous plus difficiles à créer que le ciel qu’Il a édifié ?","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5740,"text":"28. Il en a élevé bien haut la voûte et a su en parfaire la forme.","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5741,"text":"29. Il en a rendu la nuit obscure et en a fait briller le jour.","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5742,"text":"30. La terre, après cela, Il l’a nivelée.","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5743,"text":"31. Il en a fait sortir eaux et pâturages.","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5744,"text":"32. Les montagnes, Il les a implantées,","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5745,"text":"33. pour vos besoins à vous et à ceux de vos bestiaux.","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5746,"text":"34. Mais quand se produira le plus grand des cataclysmes,","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5747,"text":"35. le jour où l’homme se souviendra de ce tout ce qu’il s’est employé à accomplir,","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5748,"text":"36. et que l’Enfer sera mis en évidence devant quiconque peut voir,","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5749,"text":"37. alors, celui qui se sera livré à la démesure,","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5750,"text":"38. et qui aura préféré la vie en ce bas monde,","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5751,"text":"39. aura pour seul refuge l’Enfer !","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5752,"text":"40. Quant à celui que le statut suprême de son Seigneur (faisait trembler) de crainte, (celui qui) s’interdisait de succomber aux passions,","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5753,"text":"41. le Paradis sera son séjour.","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5754,"text":"42. Ils t’interrogent au sujet de l’Heure : « Quand va-t-elle enfin venir ? »","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5755,"text":"43. Comment saurais-tu y trouver réponse ?","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5756,"text":"44. C’est de ton Seigneur que relève son terme.","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5757,"text":"45. Tu n’es là, (quant à toi), que pour avertir quiconque l’appréhende.","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5758,"text":"46. Le jour où ils la verront, ce sera comme s’ils n’étaient restés (sur terre) qu’un après-midi ou une matinée !","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"Wan naazi 'aati gharqa","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5714,"text":"Wan naa shi taati nashta","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5715,"text":"Wass saabi-haati sabha","numberInSurah":3,"juz":30,