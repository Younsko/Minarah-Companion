[{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"وَطُورِ سِينِينَ","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"(1) By the fig and the olive[1947]","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":"[1947]- Referring to the places known for their production, i.e., Damascus and Jerusalem, respectively. It could also refer to the fig and olive trees or to the fruits themselves."},{"number":6100,"text":"(2) And [by] Mount Sinai","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6101,"text":"(3) And [by] this secure city [i.e., Makkah],","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6102,"text":"(4) We have certainly created man in the best of stature;[1948]","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":"[1948]- i.e., upright, symmetrical, and balanced in form and nature."},{"number":6103,"text":"(5) Then We return him to the lowest of the low,[1949]","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":"[1949]- This can refer to the depths of Hell, to decrepit old age or to immorality."},{"number":6104,"text":"(6) Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6105,"text":"(7) So what yet causes you to deny the Recompense?[1950]","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":"[1950]- More literally, \"What makes you lie concerning it?\""},{"number":6106,"text":"(8) Is not Allāh the most just of judges?","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"1. Par le figuier et l’olivier !","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6100,"text":"2. Par le mont Sinaï !","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6101,"text":"3. Par cette cité[612] si sûre !","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":"[612] Il s’agit de La Mecque."},{"number":6102,"text":"4. Nous avons créé l’homme dans la meilleure forme qui soit.","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6103,"text":"5. Puis Nous l’avons fait choir au rang le plus bas,","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6104,"text":"6. sauf ceux qui ont cru et accompli les bonnes œuvres, qui, eux, auront une récompense inépuisable.","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6105,"text":"7. Qu’est-ce qui te pousse (ô homme), après cela, à prendre pour un mensonge la Rétribution?","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6106,"text":"8. Allah n’est-Il pas le plus Sage des juges ?","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"Wat teeni waz zaitoon","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"Wa toori sineen","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"Wa haazal balad-il ameen","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"Laqad khalaqnal insaana fee ahsani taqweem","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"Thumma ra dad naahu asfala saafileen","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"Ill-lal lazeena aamanoo wa 'amilus saalihaati; falahum ajrun ghairu mamnoon","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"Fama yu kaz zibuka b'adu bid deen","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"Alai sal laahu bi-ahkamil haakimeen","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
