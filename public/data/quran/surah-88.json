[{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5969,"text":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5970,"text":"عَامِلَةٌۭ نَّاصِبَةٌۭ","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5971,"text":"تَصْلَىٰ نَارًا حَامِيَةًۭ","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5972,"text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","numberInSurah":5,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5973,"text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5974,"text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","numberInSurah":7,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5975,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5976,"text":"لِّسَعْيِهَا رَاضِيَةٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5977,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","numberInSurah":10,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5978,"text":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","numberInSurah":11,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5979,"text":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","numberInSurah":12,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5980,"text":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","numberInSurah":13,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5981,"text":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","numberInSurah":14,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5982,"text":"وَنَمَارِقُ مَصْفُوفَةٌۭ","numberInSurah":15,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5983,"text":"وَزَرَابِىُّ مَبْثُوثَةٌ","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5984,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5985,"text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5986,"text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5987,"text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","numberInSurah":20,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5988,"text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","numberInSurah":21,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5989,"text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","numberInSurah":22,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5990,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","numberInSurah":23,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5991,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","numberInSurah":24,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5992,"text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","numberInSurah":25,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5993,"text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","numberInSurah":26,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"(1) Has there reached you the report of the Overwhelming [event]?","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5969,"text":"(2) [Some] faces, that Day, will be humbled,","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5970,"text":"(3) Working [hard] and exhausted.[1910]","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":"[1910]- Another accepted meaning is \"They were working hard and exhausted,\" i.e., doing deeds during worldly life which did not benefit them since they were not accompanied by faith or done for the acceptance of Allāh (subḥānahu wa taʿālā) ."},{"number":5971,"text":"(4) They will [enter to] burn in an intensely hot Fire.","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5972,"text":"(5) They will be given drink from a boiling spring.","numberInSurah":5,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5973,"text":"(6) For them there will be no food except from a poisonous, thorny plant","numberInSurah":6,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5974,"text":"(7) Which neither nourishes nor avails against hunger.","numberInSurah":7,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5975,"text":"(8) [Other] faces, that Day, will show pleasure.","numberInSurah":8,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5976,"text":"(9) With their effort [they are] satisfied","numberInSurah":9,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5977,"text":"(10) In an elevated garden,","numberInSurah":10,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5978,"text":"(11) Wherein they will hear no unsuitable speech.[1911]","numberInSurah":11,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":"[1911]- i.e., any insult, falsehood, immorality, idle or vain talk, etc."},{"number":5979,"text":"(12) Within it is a flowing spring.","numberInSurah":12,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5980,"text":"(13) Within it are couches raised high","numberInSurah":13,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5981,"text":"(14) And cups put in place","numberInSurah":14,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5982,"text":"(15) And cushions lined up","numberInSurah":15,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5983,"text":"(16) And carpets spread around.","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5984,"text":"(17) Then do they not look at the camels - how they are created?","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5985,"text":"(18) And at the sky - how it is raised?","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5986,"text":"(19) And at the mountains - how they are erected?","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5987,"text":"(20) And at the earth - how it is spread out?","numberInSurah":20,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5988,"text":"(21) So remind, [O Muḥammad]; you are only a reminder.","numberInSurah":21,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5989,"text":"(22) You are not over them a controller.","numberInSurah":22,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5990,"text":"(23) However, he who turns away and disbelieves –","numberInSurah":23,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5991,"text":"(24) Then Allāh will punish him with the greatest punishment.","numberInSurah":24,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5992,"text":"(25) Indeed, to Us is their return.","numberInSurah":25,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5993,"text":"(26) Then indeed, upon Us is their account.","numberInSurah":26,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"1. T’est-il parvenu la nouvelle de (la Journée) envahissante ?","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5969,"text":"2. Des visages, ce jour-là, seront empreints d’humiliation,","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5970,"text":"3. peinant, épuisés,","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5971,"text":"4. qui brûleront dans un Feu très ardent,","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5972,"text":"5. et boiront à une source d’eau bouillante.","numberInSurah":5,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5973,"text":"6. Ils n’auront pour toute nourriture que du Dhari‘,[604]","numberInSurah":6,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":"[604] Plante hérissée d’épines."},{"number":5974,"text":"7. qui n’engraissera point, ni ne calmera la faim.","numberInSurah":7,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5975,"text":"8. Et il y aura, ce jour-là, des visages radieux,","numberInSurah":8,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5976,"text":"9. satisfaits de ce qu’ils auront accompli,","numberInSurah":9,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5977,"text":"10. dans des jardins surplombants,","numberInSurah":10,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5978,"text":"11. où il ne sera entendu aucune parole futile.","numberInSurah":11,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5979,"text":"12. Il s’y trouvera une source qui coule,","numberInSurah":12,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5980,"text":"13. des lits y seront élevés,","numberInSurah":13,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5981,"text":"14. des coupes posées,","numberInSurah":14,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5982,"text":"15. des coussins bien disposés,","numberInSurah":15,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5983,"text":"16. et des tapis étendus.","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5984,"text":"17. Ne voient-ils donc pas comment les chameaux ont été créés ?","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5985,"text":"18. Et comment le ciel a été élevé ?","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5986,"text":"19. Et comment les montagnes ont été érigées ?","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5987,"text":"20. Et comment la terre a été aplanie ?","numberInSurah":20,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5988,"text":"21. Rappelle donc ! Car tu es là pour rappeler !","numberInSurah":21,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5989,"text":"22. Tu n’as pas à les contraindre,","numberInSurah":22,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5990,"text":"23. mais celui-là seul qui se détourne et mécroit,","numberInSurah":23,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5991,"text":"24. Allah lui infligera le plus grand supplice.","numberInSurah":24,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5992,"text":"25. C’est vers Nous, certes, que sera leur retour.","numberInSurah":25,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5993,"text":"26. Puis c’est à Nous qu’il incombera de leur demander des comptes.","numberInSurah":26,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":88,"name":"سُورَةُ الغَاشِيَةِ","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"Hal ataaka hadeesul ghaashiyah","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5969,"text":"Wujoohuny yawma 'izin khaashi'ah","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5970,"text":"'Aamilatun naasibah","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5971,"text":"Taslaa naaran haamiyah","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5972,"text":"Tusqaa min 'aynin aaniyah","numberInSurah":5,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5973,"text":"Laisa lahum ta'aamun illaa min daree'","numberInSurah":6,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5974,"text":"Laa yusminu wa laa yughnee min joo'","numberInSurah":7,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5975,"text":"Wujoohuny yawma 'izin naa'imah","numberInSurah":8,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5976,"text":"Lisa'yihaa raadiyah","numberInSurah":9,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5977,"text":"Fee jannatin 'aaliyah","numberInSurah":10,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5978,"text":"Laa tasma'u feehaa laaghiyah","numberInSurah":11,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5979,"text":"Feehaa 'aynun jaariyah","numberInSurah":12,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5980,"text":"Feehaa sururum marfoo'ah","numberInSurah":13,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5981,"text":"Wa akwaabum mawdoo 'ah","numberInSurah":14,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5982,"text":"Wa namaariqu masfoofah","numberInSurah":15,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5983,"text":"Wa zaraabiyyu mabsoosah","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5984,"text":"Afalaa yanzuroona ilalibili kaifa khuliqat","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5985,"text":"Wa ilas samaaa'i kaifa rufi'at","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5986,"text":"Wa ilal jibaali kaifa nusibat","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5987,"text":"Wa ilal ardi kaifa sutihat","numberInSurah":20,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5988,"text":"Fazakkir innama anta Muzakkir","numberInSurah":21,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5989,"text":"Lasta 'alaihim bimusaitir","numberInSurah":22,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5990,"text":"Illaa man tawallaa wa kafar","numberInSurah":23,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5991,"text":"Fa yu'azzibuhul laahul 'azaabal akbar","numberInSurah":24,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5992,"text":"Innaa ilainaaa iyaabahum","numberInSurah":25,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5993,"text":"Summa inna 'alainaa hisaabahum","numberInSurah":26,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
