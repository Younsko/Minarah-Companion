[{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"text":"عَبَسَ وَتَوَلَّىٰٓ","numberInSurah":1,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5760,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5761,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","numberInSurah":3,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5762,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","numberInSurah":4,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5763,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5764,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5765,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5766,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5767,"text":"وَهُوَ يَخْشَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5768,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5769,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","numberInSurah":11,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5770,"text":"فَمَن شَآءَ ذَكَرَهُۥ","numberInSurah":12,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5771,"text":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","numberInSurah":13,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5772,"text":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","numberInSurah":14,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5773,"text":"بِأَيْدِى سَفَرَةٍۢ","numberInSurah":15,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5774,"text":"كِرَامٍۭ بَرَرَةٍۢ","numberInSurah":16,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5775,"text":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","numberInSurah":17,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5776,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","numberInSurah":18,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5777,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","numberInSurah":19,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5778,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","numberInSurah":20,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5779,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","numberInSurah":21,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5780,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","numberInSurah":22,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5781,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","numberInSurah":23,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5782,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","numberInSurah":24,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5783,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","numberInSurah":25,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5784,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","numberInSurah":26,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5785,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","numberInSurah":27,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5786,"text":"وَعِنَبًۭا وَقَضْبًۭا","numberInSurah":28,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5787,"text":"وَزَيْتُونًۭا وَنَخْلًۭا","numberInSurah":29,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5788,"text":"وَحَدَآئِقَ غُلْبًۭا","numberInSurah":30,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5789,"text":"وَفَٰكِهَةًۭ وَأَبًّۭا","numberInSurah":31,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5790,"text":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","numberInSurah":32,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5791,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","numberInSurah":33,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5792,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","numberInSurah":34,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5793,"text":"وَأُمِّهِۦ وَأَبِيهِ","numberInSurah":35,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5794,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","numberInSurah":36,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5795,"text":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","numberInSurah":37,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5796,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","numberInSurah":38,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5797,"text":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","numberInSurah":39,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5798,"text":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","numberInSurah":40,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5799,"text":"تَرْهَقُهَا قَتَرَةٌ","numberInSurah":41,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5800,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","numberInSurah":42,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"text":"(1) He [i.e., the Prophet (ﷺ) ] frowned and turned away","numberInSurah":1,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5760,"text":"(2) Because there came to him the blind man,[1853] [interrupting].","numberInSurah":2,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1853]- ʿAbdullāh, the son of Umm Maktūm."},{"number":5761,"text":"(3) But what would make you perceive, [O Muḥammad], that perhaps he might be purified[1854]","numberInSurah":3,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1854]- As a result of what he learns from you."},{"number":5762,"text":"(4) Or be reminded and the remembrance would benefit him?","numberInSurah":4,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5763,"text":"(5) As for he who thinks himself without need,[1855]","numberInSurah":5,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1855]- i.e., without need of faith or need of Allāh (subḥānahu wa taʿālā) . Here it is in reference to a certain influential member of the Quraysh whom the Prophet (ﷺ) had hoped to bring to Islām."},{"number":5764,"text":"(6) To him you give attention.","numberInSurah":6,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5765,"text":"(7) And not upon you [is any blame] if he will not be purified.[1856]","numberInSurah":7,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1856]- The Prophet (ﷺ) was responsible only for conveying the message, not for ultimate guidance."},{"number":5766,"text":"(8) But as for he who came to you striving [for knowledge]","numberInSurah":8,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5767,"text":"(9) While he fears [Allāh],","numberInSurah":9,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5768,"text":"(10) From him you are distracted.","numberInSurah":10,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5769,"text":"(11) No! Indeed, they [i.e., these verses] are a reminder;","numberInSurah":11,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5770,"text":"(12) So whoever wills may remember it.[1857]","numberInSurah":12,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1857]- The revelation. Or \"Him,\" i.e., Allāh (subḥānahu wa taʿālā) ."},{"number":5771,"text":"(13) [It is recorded] in honored sheets,","numberInSurah":13,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5772,"text":"(14) Exalted and purified,","numberInSurah":14,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5773,"text":"(15) [Carried] by the hands of messenger-angels,","numberInSurah":15,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5774,"text":"(16) Noble and dutiful.","numberInSurah":16,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5775,"text":"(17) Destroyed [i.e., cursed] is man;[1858] how disbelieving is he.","numberInSurah":17,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1858]- i.e., those who deny Allāh's message."},{"number":5776,"text":"(18) From what thing [i.e., substance] did He create him?","numberInSurah":18,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5777,"text":"(19) From a sperm-drop He created him and destined for him;[1859]","numberInSurah":19,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1859]- His proportions, provisions, life span, etc."},{"number":5778,"text":"(20) Then He eased the way for him;[1860]","numberInSurah":20,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1860]- Into this world (i.e., his birth) . It may also refer to life itself, which has been made easier by Allāh's guidance."},{"number":5779,"text":"(21) Then He causes his death and provides a grave for him.[1861]","numberInSurah":21,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1861]- To conceal his decaying body."},{"number":5780,"text":"(22) Then when He wills, He will resurrect him.","numberInSurah":22,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5781,"text":"(23) No! He [i.e., man] has not yet accomplished what He commanded him.","numberInSurah":23,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5782,"text":"(24) Then let mankind look at his food -","numberInSurah":24,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5783,"text":"(25) How We poured down water in torrents,","numberInSurah":25,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5784,"text":"(26) Then We broke open the earth, splitting [it with sprouts],","numberInSurah":26,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5785,"text":"(27) And caused to grow within it grain","numberInSurah":27,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5786,"text":"(28) And grapes and herbage","numberInSurah":28,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5787,"text":"(29) And olive and palm trees","numberInSurah":29,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5788,"text":"(30) And gardens of dense shrubbery","numberInSurah":30,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5789,"text":"(31) And fruit and grass -","numberInSurah":31,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5790,"text":"(32) [As] enjoyment [i.e., provision] for you and your grazing livestock.","numberInSurah":32,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5791,"text":"(33) But when there comes the Deafening Blast[1862]","numberInSurah":33,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1862]- The piercing blast of the Horn which signals resurrection. Aṣ-Ṣākhkhah is also a name for the Day of Resurrection."},{"number":5792,"text":"(34) On the Day a man will flee from his brother","numberInSurah":34,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5793,"text":"(35) And his mother and his father","numberInSurah":35,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5794,"text":"(36) And his wife and his children,","numberInSurah":36,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5795,"text":"(37) For every man, that Day, will be a matter adequate for him.[1863]","numberInSurah":37,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[1863]- i.e., to occupy him. He will be concerned only with himself, thus forgetting all others."},{"number":5796,"text":"(38) [Some] faces, that Day, will be bright -","numberInSurah":38,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5797,"text":"(39) Laughing, rejoicing at good news.","numberInSurah":39,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5798,"text":"(40) And [other] faces, that Day, will have upon them dust.","numberInSurah":40,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5799,"text":"(41) Blackness will cover them.","numberInSurah":41,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5800,"text":"(42) Those are the disbelievers, the wicked ones.","numberInSurah":42,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"text":"1. Il a froncé les sourcils et s’est détourné,","numberInSurah":1,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5760,"text":"2. parce que l’aveugle est venu vers lui (lui parler).[591]","numberInSurah":2,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[591] Allusion à l’aveugle Ibn Umm Maktûm qui était venu trouver le Prophète (paix et bénédiction d’Allah sur lui) pendant qu’il discutait avec des personnages importants de La Mecque. Gêné par cette irruption inopinée, le Prophète fronça les sourcils et ne cacha pas sa contrariété. Allah le lui a reproché dans cette sourate."},{"number":5761,"text":"3. Qui te dit qu’il n’allait pas se purifier ?[592]","numberInSurah":3,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[592] Se convertir à la foi musulmane."},{"number":5762,"text":"4. Ou que, rappelé, il n’allait pas profiter du rappel ?","numberInSurah":4,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5763,"text":"5. Quant à celui qui se complaît et se suffit de sa richesse,","numberInSurah":5,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5764,"text":"6. celui-là tu vas volontiers à sa rencontre,","numberInSurah":6,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5765,"text":"7. alors qu’il ne te sera fait aucun reproche s’il ne se purifie pas (de sa mécréance).","numberInSurah":7,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5766,"text":"8. Mais celui qui vient te trouver en toute hâte,","numberInSurah":8,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5767,"text":"9. et qui craint (Allah),","numberInSurah":9,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5768,"text":"10. tu le délaisses, détourné par (autre chose) !","numberInSurah":10,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5769,"text":"11. Que non, et cela est un rappel.","numberInSurah":11,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5770,"text":"12. S’en souvienne qui voudra.","numberInSurah":12,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5771,"text":"13. (Ce rappel est écrit) sur des Feuillets révérés,","numberInSurah":13,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5772,"text":"14. élevées haut et purifiées","numberInSurah":14,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5773,"text":"15. entre les mains d’émissaires[593]","numberInSurah":15,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":"[593] Les Anges."},{"number":5774,"text":"16. honorés et dévoués.","numberInSurah":16,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5775,"text":"17. Périsse l’homme ! Comme il est ingrat !","numberInSurah":17,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5776,"text":"18. De quoi l’a-t-Il créé ?","numberInSurah":18,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5777,"text":"19. C’est d’une goutte de sperme qu’Il l’a créé ; puis Il en a déterminé la destinée.","numberInSurah":19,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5778,"text":"20. Il lui a rendu facile le chemin,","numberInSurah":20,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5779,"text":"21. puis l’a fait mourir et entrer dans la tombe,","numberInSurah":21,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5780,"text":"22. puis quand Il voudra, Il le ressuscitera.","numberInSurah":22,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5781,"text":"23. Non, (l’homme) n’a pas encore accompli ce qu’(Allah) lui a ordonné.","numberInSurah":23,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5782,"text":"24. Que l’homme considère donc sa nourriture !","numberInSurah":24,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5783,"text":"25. C’est bien Nous Qui déversons l’eau (du ciel) en abondance,","numberInSurah":25,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5784,"text":"26. puis fendons (et creusons) la terre,","numberInSurah":26,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5785,"text":"27. pour y faire pousser le grain,","numberInSurah":27,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5786,"text":"28. la vigne et la luzerne,","numberInSurah":28,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5787,"text":"29. l’olivier et le palmier,","numberInSurah":29,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5788,"text":"30. et les jardins luxuriants,","numberInSurah":30,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5789,"text":"31. et les fruits et les pâturages,","numberInSurah":31,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5790,"text":"32. en jouissance pour vous et pour vos bestiaux.","numberInSurah":32,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5791,"text":"33. Mais quand viendra la Clameur retentissante,","numberInSurah":33,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5792,"text":"34. le jour où l’homme fuira son frère,","numberInSurah":34,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5793,"text":"35. sa mère et son père,","numberInSurah":35,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5794,"text":"36. sa compagne et ses enfants,","numberInSurah":36,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5795,"text":"37. alors, ce jour-là, chacun d’entre eux sera préoccupé par ce qui le concerne.","numberInSurah":37,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5796,"text":"38. Des visages, ce jour-là, seront radieux,","numberInSurah":38,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5797,"text":"39. riants et pleins d’espérance.","numberInSurah":39,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5798,"text":"40. Et (d’autres) visages, ce jour-là, seront couverts de poussière","numberInSurah":40,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5799,"text":"41. rembrunis par les ténèbres.","numberInSurah":41,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null},{"number":5800,"text":"42. Ceux-là sont les mécréants et les pervers !","numberInSurah":42,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":80,"name":"سُورَةُ عَبَسَ","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"text":"'Abasa wa tawallaa.","numberInSurah":1,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5760,"text":"An jaa-ahul 'a-maa","numberInSurah":2,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5761,"text":"Wa maa yudreeka la'allahu yaz zakkaa.","numberInSurah":3,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5762,"text":"Au yaz zak karu fatanfa 'ahuz zikraa.","numberInSurah":4,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5763,"text":"Amma manis taghnaa","numberInSurah":5,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5764,"text":"Fa-anta lahu tasaddaa","numberInSurah":6,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5765,"text":"Wa ma 'alaika allaa yaz zakka.","numberInSurah":7,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5766,"text":"Wa amma man jaa-aka yas'a","numberInSurah":8,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5767,"text":"Wahuwa yakhshaa,","numberInSurah":9,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5768,"text":"Fa-anta 'anhu talah haa.","numberInSurah":10,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5769,"text":"Kalla innaha tazkirah","numberInSurah":11,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5770,"text":"Faman shaa a zakarah","numberInSurah":12,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5771,"text":"Fi suhufim mukar rama,","numberInSurah":13,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5772,"text":"Marfoo'atim mutah hara,","numberInSurah":14,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5773,"text":"Bi'aidee safara","numberInSurah":15,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5774,"text":"Kiraamim bararah.","numberInSurah":16,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5775,"text":"Qutilal-insanu maa akfarah.","numberInSurah":17,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5776,"text":"Min aiyyi shai-in Khalaq","numberInSurah":18,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5777,"text":"Min nutfah; khalaqahu faqad-darah.","numberInSurah":19,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5778,"text":"Thummas sabeela yas-sarah","numberInSurah":20,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5779,"text":"Thumma amatahu fa-aqbarah","numberInSurah":21,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5780,"text":"Thumma iza shaa-a ansharah","numberInSurah":22,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5781,"text":"Kalla lamma yaqdi maa amarah.","numberInSurah":23,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5782,"text":"Falyanzuril insanu ilaa ta-amih","numberInSurah":24,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5783,"text":"Anna sabab nalmaa-a sabba.","numberInSurah":25,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5784,"text":"Thumma sha qaqnal-arda shaqqa.","numberInSurah":26,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5785,"text":"Fa ambatna feeha habba","numberInSurah":27,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5786,"text":"Wa 'inabaw-wa qadba","numberInSurah":28,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5787,"text":"Wa zaitoonaw wanakh la'","numberInSurah":29,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5788,"text":"Wa hadaa-iqa ghulba","numberInSurah":30,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5789,"text":"Wa faki hataw-wa abba.","numberInSurah":31,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5790,"text":"Mata'al-lakum wa li-an'amikum.","numberInSurah":32,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5791,"text":"Faiza jaa-atis saakhah.","numberInSurah":33,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5792,"text":"Yauma yafir-rul mar-u min akheeh","numberInSurah":34,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5793,"text":"Wa ummihee wa abeeh","numberInSurah":35,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5794,"text":"Wa sahi batihee wa baneeh.","numberInSurah":36,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5795,"text":"Likul limri-im-minuhm yaumaa-izin shaa nuy-yughneeh","numberInSurah":37,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5796,"text":"Wujoo huny-yauma-izim-musfira;","numberInSurah":38,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5797,"text":"Dahi katum mustab shirah","numberInSurah":39,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5798,"text":"Wa wujoohuy yauma-izin 'alaiha ghabar a","numberInSurah":40,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5799,"text":"Tarhaquha qatarah.","numberInSurah":41,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5800,"text":"Ulaa-ika humul-kafa ratul-fajarah.","numberInSurah":42,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
