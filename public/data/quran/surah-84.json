526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"وَٱلَّيْلِ وَمَا وَسَقَ","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"(1) When the sky has split [open]","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5886,"text":"(2) And has listened [i.e., responded][1888] to its Lord and was obligated [to do so]","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":"[1888]- It will have heard Allāh's command and will have inclined immediately to compliance and willing obedience."},{"number":5887,"text":"(3) And when the earth has been extended[1889]","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":"[1889]- i.e., stretched flat and spread out."},{"number":5888,"text":"(4) And has cast out that within it[1890] and relinquished [it]","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":"[1890]- Of the dead and all else buried therein."},{"number":5889,"text":"(5) And has listened [i.e., responded] to its Lord and was obligated [to do so] –","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5890,"text":"(6) O mankind, indeed you are laboring toward your Lord with [great] exertion[1891] and will meet it.[1892]","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":"[1891]- i.e., striving throughout your life until you meet your Lord, hastening toward death.\n[1892]- i.e., you will find all that you intended and accomplished awaiting you in the Hereafter. Another meaning is \"And will meet Him [i.e., your Lord]\" and be recompensed in full by Him."},{"number":5891,"text":"(7) Then as for he who is given his record in his right hand,","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5892,"text":"(8) He will be judged with an easy account","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5893,"text":"(9) And return to his people in happiness.","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5894,"text":"(10) But as for he who is given his record behind his back,","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5895,"text":"(11) He will cry out for destruction","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5896,"text":"(12) And [enter to] burn in a Blaze.","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5897,"text":"(13) Indeed, he had [once] been among his people in happiness;","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5898,"text":"(14) Indeed, he had thought he would never return [to Allāh].","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5899,"text":"(15) But yes! Indeed, his Lord was ever, of him, Seeing.","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5900,"text":"(16) So I swear by the twilight glow","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5901,"text":"(17) And [by] the night and what it envelops","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5902,"text":"(18) And [by] the moon when it becomes full","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5903,"text":"(19) [That] you will surely embark upon [i.e., experience] state after state.[1893]","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":"[1893]- i.e., various stages, both in this life and in the Hereafter."},{"number":5904,"text":"(20) So what is [the matter] with them [that] they do not believe,","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5905,"text":"(21) And when the Qur’ān is recited to them, they do not prostrate [to Allāh]?","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false},"footnotes":null},{"number":5906,"text":"(22) But those who have disbelieved deny,","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5907,"text":"(23) And Allāh is most knowing of what they keep within themselves.","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5908,"text":"(24) So give them tidings of a painful punishment,","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5909,"text":"(25) Except for those who believe and do righteous deeds. For them is a reward uninterrupted.","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"1. Quand le ciel sera lézardé,","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5886,"text":"2. et qu’il aura obéi à son Seigneur et accompli son devoir,","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5887,"text":"3. quand la terre sera aplanie,","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5888,"text":"4. qu’elle aura expulsé son contenu et s’en sera débarrassée,","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5889,"text":"5. et qu’elle aura obéi à son Seigneur et accompli son devoir,","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5890,"text":"6. alors, ô toi être humain qui sans cesse t’évertues pour aller vers ton Seigneur, (sache que) tu Le rencontreras !","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5891,"text":"7. Celui qui aura reçu son Livre en sa main droite","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5892,"text":"8. sera jugé d’un jugement clément,","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5893,"text":"9. et s’en reviendra heureux auprès de sa famille.","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5894,"text":"10. Quant à celui qui recevra son Livre derrière son dos,","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5895,"text":"11. il criera au malheur","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5896,"text":"12. et brûlera dans le Brasier.","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5897,"text":"13. Il était heureux auprès de sa famille,","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5898,"text":"14. s’imaginant que jamais il ne reviendrait à la vie (pour être jugé).","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5899,"text":"15. Eh bien si ! Son Seigneur, Tout Voyant, l’observait en permanence.","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5900,"text":"16. J’en jure par le crépuscule !","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5901,"text":"17. Par la nuit et ce qu’elle englobe !","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5902,"text":"18. Par la lune quand elle est pleine !","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5903,"text":"19. Vous passerez sans cesse étape par étape.","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5904,"text":"20. Pourquoi donc ne croient-ils pas ?","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5905,"text":"21. Et quand le Coran leur est lu ne se prosternent-ils pas ?[600]","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false},"footnotes":"[600] Une prosternation est recommandée après la lecture de ce verset."},{"number":5906,"text":"22. C’est que les mécréants le tiennent pour mensonge.","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5907,"text":"23. Mais Allah Sait le mieux (les sentiments secrets) qu’ils nourrissent.","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5908,"text":"24. Annonce-leur donc un supplice très douloureux.","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null},{"number":5909,"text":"25. À l’exception de ceux qui ont cru et ont accompli les bonnes œuvres, et qui auront alors une récompense illimitée.","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"Izas samaaa'un shaqqat","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"Wa az