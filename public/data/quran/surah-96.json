u":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"Sanad 'uz zabaaniyah","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"Kalla; la tuti'hu wasjud waqtarib","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
