[{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"عَبْدًا إِذَا صَلَّىٰٓ","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"فَلْيَدْعُ نَادِيَهُۥ","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"(1) Recite in the name of your Lord who created –","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6108,"text":"(2) Created man from a clinging substance.","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6109,"text":"(3) Recite, and your Lord is the most Generous -","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6110,"text":"(4) Who taught by the pen –","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6111,"text":"(5) Taught man that which he knew not.","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6112,"text":"(6) No! [But] indeed, man transgresses","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6113,"text":"(7) Because he sees himself self-sufficient.","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6114,"text":"(8) Indeed, to your Lord is the return.","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6115,"text":"(9) Have you seen the one who forbids","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6116,"text":"(10) A servant when he prays?","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6117,"text":"(11) Have you seen if he is upon guidance","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6118,"text":"(12) Or enjoins righteousness?","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6119,"text":"(13) Have you seen if he denies and turns away -","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6120,"text":"(14) Does he not know that Allāh sees?","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6121,"text":"(15) No! If he does not desist, We will surely drag him by the forelock[1952] –","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":"[1952]- It may also mean \"slap him\" or \"blacken his face at the forelock.\""},{"number":6122,"text":"(16) A lying, sinning forelock.","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6123,"text":"(17) Then let him call his associates;","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6124,"text":"(18) We will call the angels of Hell.[1953]","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":"[1953]- Those who push the wicked into the Fire."},{"number":6125,"text":"(19) No! Do not obey him. But prostrate and draw near [to Allāh].","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true},"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"1. Lis par le nom de ton Seigneur Qui a créé !","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6108,"text":"2. Qui a créé l’homme d’un grumeau de sang.","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6109,"text":"3. Lis, car ton Seigneur est le Plus Noble","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6110,"text":"4. Qui enseigna par le Calame.","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6111,"text":"5. Qui enseigna à l’homme ce qu’il ne savait pas.","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6112,"text":"6. Mais non ! L’homme devient certes rebelle,","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6113,"text":"7. dès qu’il se voit gagner en richesses.","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6114,"text":"8. Vers ton Seigneur sera le retour.","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6115,"text":"9. N’as-tu pas vu celui qui défend","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6116,"text":"10. à un serviteur (d’Allah) de faire la prière ?","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6117,"text":"11. Que penserais-tu si (ce dernier) était auparavant sur la bonne voie,","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6118,"text":"12. et appelait à la piété ?","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6119,"text":"13. Et que penserais-tu si (le premier) traitait de mensonge (le Message) et s’en détournait ?","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6120,"text":"14. Ne sait-il pas qu’Allah Voit Tout ?","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6121,"text":"15. Certes non ! S’il ne cesse pas, Nous le prendrons par le toupet,","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6122,"text":"16. un toupet menteur et coupable.","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6123,"text":"17. Qu’il appelle donc son clan (à son secours).","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6124,"text":"18. Nous ferons appel aux gardiens (de l’Enfer).","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6125,"text":"19. Non ! Ne lui obéis pas ! Prosterne-toi et rapproche-toi (d’Allah) ![613]","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true},"footnotes":"[613] Une prosternation est recommandée après la lecture de ce verset."}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"Iqra bismi rab bikal lazee khalaq","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"Khalaqal insaana min 'alaq","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"Iqra wa rab bukal akram","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":fals