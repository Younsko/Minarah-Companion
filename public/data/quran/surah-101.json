[{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"ٱلْقَارِعَةُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"مَا ٱلْقَارِعَةُ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"نَارٌ حَامِيَةٌۢ","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"(1) The Striking Calamity -","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6159,"text":"(2) What is the Striking Calamity?","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6160,"text":"(3) And what can make you know what is the Striking Calamity?","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6161,"text":"(4) It is the Day when people will be like moths, dispersed,[1975]","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":"[1975]- The people will be as such after having been expelled from their graves."},{"number":6162,"text":"(5) And the mountains will be like wool, fluffed up.[1976]","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":"[1976]- i.e., beginning to disintegrate."},{"number":6163,"text":"(6) Then as for one whose scales are heavy [with good deeds],","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6164,"text":"(7) He will be in a pleasant life.","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6165,"text":"(8) But as for one whose scales are light,","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6166,"text":"(9) His refuge[1977] will be an abyss.[1978]","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":"[1977]- Literally, \"mother\" (a man's original refuge) , which will envelop him as in an embrace.\n[1978]- i.e., the pit of Hellfire."},{"number":6167,"text":"(10) And what can make you know what that is?","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6168,"text":"(11) It is a Fire, intensely hot.","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"1. Le Fracas!","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6159,"text":"2. Mais qu’est-ce donc que le Fracas ?","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6160,"text":"3. Et qui te fera jamais savoir ce que c’est que le Fracas ?","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6161,"text":"4. C’est le jour où les hommes seront tels des papillons dispersés,","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6162,"text":"5. où les montagnes seront comme de la laine démêlée en flocons.","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6163,"text":"6. Quant à celui dont les (œuvres) seront lourdes à la balance,","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6164,"text":"7. il aura une vie agréable,[617]","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":"[617] L’adjectif est employé ici dans son sens premier : une vie qu’il agrée, dont il est satisfait."},{"number":6165,"text":"8. et quant à celui dont les (œuvres) seront légères à la balance,","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6166,"text":"9. sa destination sera l’abîme.","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6167,"text":"10. Et qui te fera jamais savoir ce que c’est (que l’abîme)?","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6168,"text":"11. Un Feu très ardent !","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"Al qaari'ah","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"Mal qaariah","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"Wa maa adraaka mal qaari'ah","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"Yauma ya koonun naasu kal farashil mabthooth","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"Wa ta koonul jibalu kal 'ihnil manfoosh","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"Fa-amma man thaqulat mawa zeenuh","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"Fahuwa fee 'ishatir raadiyah","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"Wa amma man khaffat mawa zeenuh","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"Fa-ummuhu haawiyah","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"Wa maa adraaka maa hiyah","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"Naarun hamiyah","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
