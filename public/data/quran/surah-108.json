[{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"(1) Indeed, We have granted you, [O Muḥammad], al-Kawthar.","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6206,"text":"(2) So pray to your Lord and offer sacrifice [to Him alone].","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6207,"text":"(3) Indeed, your enemy is the one cut off.[2002]","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false,"footnotes":"[2002]- From all good in this world and the Hereafter."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"1. Nous t’avons certes donné un Fleuve d’Abondance.[620]","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false,"footnotes":"[620] Cette traduction a le mérite de rendre compte des deux sens du mot « kawthar » : abondance tout court dans ce bas monde, (dans ce cas l’expression « fleuve d’abondance » serait une hyperbole par métaphore, comme dans l’expression « un fleuve d’idées » ou l’expression « corne d’abondance »), et fleuve qui en porte le nom au Paradis."},{"number":6206,"text":"2. Observe donc la Çalât pour ton Seigneur, et sacrifie !","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6207,"text":"3. C’est celui qui te hait qui sera sans postérité.","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"Innaa a'taina kal kauthar","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"Fa salli li rabbika wanhar","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"Inna shani-aka huwal abtar","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
