[{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"(1) Did We not expand for you, [O Muḥammad], your breast?[1944]","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":"[1944]- i.e., enlighten, assure and gladden your heart with guidance."},{"number":6092,"text":"(2) And We removed from you your burden[1945]","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":"[1945]- By forgiving any errors which you may have committed previously or might commit consequently. \"Burden\" can also refer to the anxiety experienced by the Prophet (ﷺ) at the beginning of his mission."},{"number":6093,"text":"(3) Which had weighed upon your back","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6094,"text":"(4) And raised high for you your repute.","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6095,"text":"(5) For indeed, with hardship [will be] ease [i.e., relief].","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6096,"text":"(6) Indeed, with hardship [will be] ease.","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6097,"text":"(7) So when you have finished [your duties], then stand up [for worship].","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6098,"text":"(8) And to your Lord direct [your] longing.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"1. Ne t’avons-Nous pas ouvert la poitrine?","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6092,"text":"2. N’avons-Nous pas déposé pour toi ton fardeau","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6093,"text":"3. qui pesait si lourd sur ton dos ?","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6094,"text":"4. (N’avons-Nous) pas élevé ton nom ?","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6095,"text":"5. Certes, avec la peine vient le soulagement;","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6096,"text":"6. Oui, avec la peine vient le soulagement.","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6097,"text":"7. Quand tu auras accompli (tes devoirs terrestres), lève-toi (pour la prière),","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6098,"text":"8. Et recherche ton Seigneur avec empressement !","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"Alam nashrah laka sadrak","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"Wa wa d'ana 'anka wizrak","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"Allazee anqada zahrak","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"Wa raf 'ana laka zikrak","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"Fa inna ma'al usri yusra","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"Inna ma'al 'usri yusra","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"Fa iza faragh ta fansab","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"Wa ilaa rabbika far ghab","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
