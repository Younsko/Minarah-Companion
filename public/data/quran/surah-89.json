[{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"وَٱلْفَجْرِ","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"وَلَيَالٍ عَشْرٍۢ","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"وَٱلَّيْلِ إِذَا يَسْرِ","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5998,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5999,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6000,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6001,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6002,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6003,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6004,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6005,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6006,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6007,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6008,"text":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6009,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6010,"text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6011,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6012,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6013,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6014,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6015,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6016,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6017,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6018,"text":"فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6019,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6020,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"فَٱدْخُلِى فِى عِبَٰدِى","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"وَٱدْخُلِى جَنَّتِى","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"(1) By the dawn","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5995,"text":"(2) And [by] ten nights[1913]","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1913]- Usually interpreted as the first ten nights of the month of Dhul-Ḥijjah."},{"number":5996,"text":"(3) And [by] the even [number] and the odd","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5997,"text":"(4) And [by] the night when it passes,","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5998,"text":"(5) Is there [not] in [all] that an oath [sufficient] for one of perception?[1914]","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1914]- Based upon the following verses, what has been sworn to by Allāh is that He will certainly punish the disbelievers."},{"number":5999,"text":"(6) Have you not considered how your Lord dealt with ʿAad -","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6000,"text":"(7) [With] Iram[1915] - who had lofty pillars,[1916]","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1915]- Another name for the first people of ʿAad, to whom Prophet Hūd was sent.\n[1916]- Supporting their tents or buildings."},{"number":6001,"text":"(8) The likes of whom had never been created in the land?","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6002,"text":"(9) And [with] Thamūd, who carved out the rocks in the valley?","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6003,"text":"(10) And [with] Pharaoh, owner of the stakes?[1917]","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1917]- By which he tortured people."},{"number":6004,"text":"(11) [All of] whom oppressed within the lands","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6005,"text":"(12) And increased therein the corruption.","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6006,"text":"(13) So your Lord poured upon them a scourge of punishment.","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6007,"text":"(14) Indeed, your Lord is in observation.","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6008,"text":"(15) And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"[1918]","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1918]- He is proud rather than grateful, attributing the favor to his own merit."},{"number":6009,"text":"(16) But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6010,"text":"(17) No![1919] But you do not honor the orphan","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1919]- It is not like you imagine. Rather, Allāh tries people through prosperity and hardship and rewards both gratitude and patience with honor in the Hereafter."},{"number":6011,"text":"(18) And you do not encourage one another to feed the poor.","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6012,"text":"(19) And you consume inheritance, devouring [it] altogether,[1920]","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1920]- Not caring whether it is lawful or unlawful."},{"number":6013,"text":"(20) And you love wealth with immense love.","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6014,"text":"(21) No! When the earth has been leveled - pounded and crushed","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6015,"text":"(22) And your Lord has come[1921] and the angels, rank upon rank,","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1921]- To pass judgement. See footnote to 2:19."},{"number":6016,"text":"(23) And brought [within view], that Day, is Hell - that Day, man will remember, but how [i.e., what good] to him will be the remembrance?","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6017,"text":"(24) He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"[1922]","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":"[1922]- The everlasting life of the Hereafter."},{"number":6018,"text":"(25) So on that Day, none will punish [as severely] as His punishment,","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6019,"text":"(26) And none will bind [as severely] as His binding [of the evildoers].","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6020,"text":"(27) [To the righteous it will be said], \"O reassured soul,","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6021,"text":"(28) Return to your Lord, well-pleased and pleasing [to Him],","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6022,"text":"(29) And enter among My [righteous] servants","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6023,"text":"(30) And enter My Paradise.\"","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"1. Par l’aube !","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5995,"text":"2. Par les Dix nuits !","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5996,"text":"3. Par le pair et l’impair !","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5997,"text":"4. Par la nuit quand elle passe!","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5998,"text":"5. N’y a-t-il pas là un serment pour un esprit sagace?","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5999,"text":"6. Ne vois-tu pas ce que ton Seigneur a fait des ‘Ad,","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6000,"text":"7. et de Iram, la cité aux (hautes) colonnes,","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6001,"text":"8. à laquelle jamais cité semblable ne fut créée dans la contrée ?","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6002,"text":"9. Et (ce qu’Il a fait) des Thamûd qui avaient taillé (leurs maisons) à même le roc dans la vallée,","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6003,"text":"10. et de Pharaon, (qui avait inventé le supplice) des épieux,","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6004,"text":"11. qui tous transgressaient dans la contrée,","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6005,"text":"12. et y semaient un grand désordre ?","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6006,"text":"13. Ton Seigneur sévit alors contre eux par le fouet de (Son) supplice.","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6007,"text":"14. Car, certes, ton Seigneur toujours guette.","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6008,"text":"15. Quand son Seigneur, en l’éprouvant, l’honore et le comble de bienfaits, l’homme dit : « Mon Seigneur m’a honoré ! »","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6009,"text":"16. Mais quand, en l’éprouvant, Il lui accorde parcimonieusement sa subsistance, il proteste : « Mon Seigneur m’a humilié ! »","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6010,"text":"17. Que non ! Car c’est plutôt vous qui manquez de générosité envers l’orphelin,","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6011,"text":"18. qui ne vous exhortez pas (les uns les autres) à nourrir le pauvre,","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6012,"text":"19. qui vous emparez des héritages avec cupidité,","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6013,"text":"20. et aimez les richesses d’un amour démesuré.","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6014,"text":"21. Que non ! Lorsque la terre s’effritera parcelle par parcelle,","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6015,"text":"22. et lorsque ton Seigneur viendra, de même que les Anges, rangée par rangée,","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6016,"text":"23. et lorsque, ce jour-là, la Géhenne sera amenée; ce jour-là alors, l’homme se souviendra. Mais à quoi pourrait bien lui servir de se souvenir ?","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6017,"text":"24. Il dira : « Ah, Si seulement j’avais prévu (de faire le bien) pour ma vie (dans l’autre monde) ! »","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6018,"text":"25. Ce jour-là, nul ne suppliciera comme Lui supplicie.","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6019,"text":"26. Nul ne ligotera comme Lui ligote.","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6020,"text":"27. « Ô toi, âme sereine !","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6021,"text":"28. Reviens vers ton Seigneur, contente et agréée !","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6022,"text":"29. Entre parmi Mes serviteurs !","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":6023,"text":"30. Entre dans Mon Paradis !»","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":89,"name":"سُورَةُ الفَجۡرِ","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"Wal-Fajr","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"Wa layaalin 'ashr","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"Wash shaf'i wal watr","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"Wallaili izaa yasr","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5998,"text":"Hal fee zaalika qasamul lizee hijr","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5999,"text":"Alam tara kaifa fa'ala rabbuka bi'aad","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6000,"text":"Iramaa zaatil 'imaad","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6001,"text":"Allatee lam yukhlaq misluhaa fil bilaad","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6002,"text":"Wa samoodal lazeena jaabus sakhra bil waad","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6003,"text":"Wa fir'awna zil awtaad","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6004,"text":"Allazeena taghaw fil bilaad","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6005,"text":"Fa aksaroo feehal fasaad","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6006,"text":"Fasabba 'alaihim Rabbuka sawta 'azaab","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6007,"text":"Inna Rabbaka labil mirsaad","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6008,"text":"Fa ammal insaanu izaa mab talaahu Rabbuhoo fa akramahoo wa na' 'amahoo fa yaqoolu Rabbeee akraman","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6009,"text":"Wa ammaaa izaa mabtalaahu faqadara 'alaihi rizqahoo fa yaqoolu Rabbeee ahaanan","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6010,"text":"Kalla bal laa tukrimooo nal yateem","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6011,"text":"Wa laa tahaaaddoona 'alaata'aamil miskeen","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6012,"text":"Wa taakuloonat turaasa aklal lammaa","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6013,"text":"Wa tuhibboonal maala hubban jammaa","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6014,"text":"Kallaaa izaaa dukkatil ardu dakkan dakka","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6015,"text":"Wa jaaa'a Rabbuka wal malaku saffan saffaa","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6016,"text":"Wa jeee'a yawma'izim bi jahannnam; Yawma 'iziny yatazakkarul insaanu wa annaa lahuz zikraa","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6017,"text":"Yaqoolu yaa laitanee qaddamtu lihayaatee","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6018,"text":"Fa Yawma izil laa yu'azzibu 'azaabahooo ahad","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6019,"text":"Wa laa yoosiqu wasaaqa hooo ahad","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6020,"text":"Yaaa ayyatuhan nafsul mutma 'innah","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"Irji'eee ilaa Rabbiki raadiyatam mardiyyah","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"Fadkhulee fee 'ibaadee","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"Wadkhulee jannatee","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
