[{"number":97,"name":"سُورَةُ القَدۡرِ","englishName":"Al-Qadr","englishNameTranslation":"The Power, Fate","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6126,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","numberInSurah":1,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6127,"text":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","numberInSurah":2,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6128,"text":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ","numberInSurah":3,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6129,"text":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ","numberInSurah":4,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6130,"text":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","numberInSurah":5,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":97,"name":"سُورَةُ القَدۡرِ","englishName":"Al-Qadr","englishNameTranslation":"The Power, Fate","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6126,"text":"(1) Indeed, We sent it [i.e., the Qur’ān] down during the Night of Decree.","numberInSurah":1,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6127,"text":"(2) And what can make you know what is the Night of Decree?","numberInSurah":2,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6128,"text":"(3) The Night of Decree is better than a thousand months.","numberInSurah":3,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6129,"text":"(4) The angels and the Spirit [i.e., Gabriel] descend therein by permission of their Lord for every matter.[1955]","numberInSurah":4,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":"[1955]- Bringing the exact measures apportioned for everything by Allāh in the course of the coming year."},{"number":6130,"text":"(5) Peace it is[1956] until the emergence of dawn.","numberInSurah":5,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":"[1956]- Upon the believers."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":97,"name":"سُورَةُ القَدۡرِ","englishName":"Al-Qadr","englishNameTranslation":"The Power, Fate","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6126,"text":"1. Nous l’avons révélé en la nuit du Destin.","numberInSurah":1,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6127,"text":"2. Et qui te fera jamais savoir ce qu’est la nuit du Destin ?","numberInSurah":2,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6128,"text":"3. La nuit du Destin vaut mieux que mille mois.","numberInSurah":3,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null},{"number":6129,"text":"4. En cette nuit, descendent les Anges et l’Esprit[614] avec la permission de leur Seigneur et avec les ordres pour toutes choses.[615]","numberInSurah":4,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":"[614] L’Ange Gabriel.\n[615] En cette nuit, les Anges descendent avec les ordres arrêtés par Allah pour l’année à venir."},{"number":6130,"text":"5. Paix elle est jusqu’au lever de l’aube.","numberInSurah":5,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":97,"name":"سُورَةُ القَدۡرِ","englishName":"Al-Qadr","englishNameTranslation":"The Power, Fate","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6126,"text":"Innaa anzalnaahu fee lailatil qadr","numberInSurah":1,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6127,"text":"Wa maa adraaka ma lailatul qadr","numberInSurah":2,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6128,"text":"Lailatul qadri khairum min alfee shahr","numberInSurah":3,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6129,"text":"Tanaz zalul malaa-ikatu war roohu feeha bi izni-rab bihim min kulli amr","numberInSurah":4,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false},{"number":6130,"text":"Salaamun hiya hattaa mat la'il fajr","numberInSurah":5,"juz":30,"manzil":7,"page":598,"ruku":539,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
