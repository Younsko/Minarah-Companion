[{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"لِإِيلَٰفِ قُرَيْشٍ","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"(1) For the accustomed security of the Quraysh[1996] -","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":"[1996]- i.e., the honor and reputation Allāh had given them as guardians of the Holy Kaʿbah, which allowed them to travel without fear of being harmed."},{"number":6195,"text":"(2) Their accustomed security [in] the caravan of winter and summer[1997] -","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":"[1997]- i.e., the trading caravans that traveled south in winter and north in summer."},{"number":6196,"text":"(3) Let them worship the Lord of this House,[1998]","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":"[1998]- i.e., the Kaʿbah."},{"number":6197,"text":"(4) Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"1. Pour les bienfaits reçus par Qoraïch,","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6195,"text":"2. Pour les bienfaits de leurs voyages d’hiver et d’été,","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6196,"text":"3. qu’ils adorent donc le Seigneur de cette Maison,[619]","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":"[619] La Kaâba."},{"number":6197,"text":"4. Qui les a nourris au mépris de la faim, et les a rassurés en dépit de la peur !","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"numb