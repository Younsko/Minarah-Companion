thmani","format":"text","type":"quran","direction":"rtl"}},{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","numberOfAyahs":50,"ayahs":[{"number":5623,"text":"(1) By those [winds] sent forth in gusts","numberInSurah":1,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5624,"text":"(2) And the winds that blow violently","numberInSurah":2,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5625,"text":"(3) And [by] the winds that spread [clouds]","numberInSurah":3,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5626,"text":"(4) And those [angels] who bring criterion[1816]","numberInSurah":4,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":"[1816]- To Allāh's human messengers."},{"number":5627,"text":"(5) And those [angels] who deliver a message","numberInSurah":5,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5628,"text":"(6) As justification or warning,","numberInSurah":6,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5629,"text":"(7) Indeed, what you are promised is to occur.","numberInSurah":7,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5630,"text":"(8) So when the stars are obliterated","numberInSurah":8,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5631,"text":"(9) And when the heaven is opened","numberInSurah":9,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5632,"text":"(10) And when the mountains are blown away","numberInSurah":10,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5633,"text":"(11) And when the messengers' time has come...[1817]","numberInSurah":11,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":"[1817]- i.e., when they are gathered to witness concerning their nations. The sentence's conclusion is understood to be \"...the promised judgement will then take place.\""},{"number":5634,"text":"(12) For what Day was it postponed?[1818]","numberInSurah":12,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":"[1818]- \"It\" may refer to either the aforementioned occurrences collectively or to the testimony of the messengers."},{"number":5635,"text":"(13) For the Day of Judgement.","numberInSurah":13,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5636,"text":"(14) And what can make you know what is the Day of Judgement?","numberInSurah":14,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5637,"text":"(15) Woe,[1819] that Day, to the deniers.","numberInSurah":15,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":"[1819]- i.e., death and destruction."},{"number":5638,"text":"(16) Did We not destroy the former peoples?","numberInSurah":16,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5639,"text":"(17) Then We will follow them with the later ones.","numberInSurah":17,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5640,"text":"(18) Thus do We deal with the criminals.","numberInSurah":18,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5641,"text":"(19) Woe, that Day, to the deniers.","numberInSurah":19,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5642,"text":"(20) Did We not create you from a liquid disdained?","numberInSurah":20,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5643,"text":"(21) And We placed it in a firm lodging [i.e., the womb]","numberInSurah":21,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5644,"text":"(22) For a known extent.","numberInSurah":22,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5645,"text":"(23) And We determined [it], and excellent [are We] to determine.","numberInSurah":23,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5646,"text":"(24) Woe, that Day, to the deniers.","numberInSurah":24,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5647,"text":"(25) Have We not made the earth a container","numberInSurah":25,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5648,"text":"(26) Of the living and the dead?","numberInSurah":26,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5649,"text":"(27) And We placed therein lofty, firmly set mountains and have given you to drink sweet water.","numberInSurah":27,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5650,"text":"(28) Woe, that Day, to the deniers.","numberInSurah":28,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5651,"text":"(29) [They will be told], \"Proceed to that which you used to deny.","numberInSurah":29,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5652,"text":"(30) Proceed to a shadow [of smoke] having three columns","numberInSurah":30,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5653,"text":"(31) [But having] no cool shade and availing not against the flame.\"","numberInSurah":31,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5654,"text":"(32) Indeed, it throws sparks [as huge] as a fortress,","numberInSurah":32,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5655,"text":"(33) As if they were yellowish [black] camels.","numberInSurah":33,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5656,"text":"(34) Woe, that Day, to the deniers.","numberInSurah":34,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5657,"text":"(35) This is a Day they will not speak,","numberInSurah":35,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5658,"text":"(36) Nor will it be permitted for them to make an excuse.","numberInSurah":36,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5659,"text":"(37) Woe, that Day, to the deniers.","numberInSurah":37,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5660,"text":"(38) This is the Day of Judgement; We will have assembled you and the former peoples.","numberInSurah":38,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5661,"text":"(39) So if you have a plan, then plan against Me.","numberInSurah":39,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5662,"text":"(40) Woe, that Day, to the deniers.","numberInSurah":40,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5663,"text":"(41) Indeed, the righteous will be among shades and springs","numberInSurah":41,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5664,"text":"(42) And fruits from whatever they desire,","numberInSurah":42,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5665,"text":"(43) [Being told], \"Eat and drink in satisfaction for what you used to do.\"","numberInSurah":43,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5666,"text":"(44) Indeed, We thus reward the doers of good.","numberInSurah":44,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5667,"text":"(45) Woe, that Day, to the deniers.","numberInSurah":45,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5668,"text":"(46) [O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals.","numberInSurah":46,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5669,"text":"(47) Woe, that Day, to the deniers.","numberInSurah":47,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5670,"text":"(48) And when it is said to them, \"Bow [in prayer],\" they do not bow.","numberInSurah":48,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5671,"text":"(49) Woe, that Day, to the deniers.","numberInSurah":49,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5672,"text":"(50) Then in what statement after it [i.e., the Qur’ān] will they believe?","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","numberOfAyahs":50,"ayahs":[{"number":5623,"text":"1. Par ceux qui sont envoyés l’un après l’autre !","numberInSurah":1,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5624,"text":"2. Par les tempêtes déchaînées !","numberInSurah":2,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5625,"text":"3. Par ceux qui répandent et déploient,","numberInSurah":3,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5626,"text":"4. séparent et discernent !","numberInSurah":4,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5627,"text":"5. Par ceux qui sèment (partout) le Rappel,","numberInSurah":5,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5628,"text":"6. soit pour justifier soit pour avertir !","numberInSurah":6,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5629,"text":"7. Ce qui vous est promis s’accomplira certainement.","numberInSurah":7,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5630,"text":"8. Quand les étoiles seront éteintes,","numberInSurah":8,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5631,"text":"9. et que le ciel sera fendu,","numberInSurah":9,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5632,"text":"10. et que les montagnes seront désintégrées,","numberInSurah":10,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5633,"text":"11. et que le moment sera venu pour les Messagers de comparaître,","numberInSurah":11,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5634,"text":"12. à quel jour cela est-il donc différé ?","numberInSurah":12,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5635,"text":"13. Au jour de la Décision.","numberInSurah":13,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5636,"text":"14. Et qui te fera jamais savoir ce qu’est le jour de la Décision ?","numberInSurah":14,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5637,"text":"15. Malheur, ce jour-là, aux négateurs !","numberInSurah":15,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5638,"text":"16. N’avons-Nous pas anéanti les (peuples) premiers ?","numberInSurah":16,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5639,"text":"17. Puis n’avons-Nous pas enchaîné par les derniers ?","numberInSurah":17,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5640,"text":"18. C’est ainsi que Nous traitons les criminels.","numberInSurah":18,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5641,"text":"19. Malheur, ce jour-là, aux négateurs !","numberInSurah":19,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5642,"text":"20. Ne vous avons-Nous pas créés d’un vulgaire liquide,","numberInSurah":20,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5643,"text":"21. que Nous avons établi dans un réceptacle sûr,","numberInSurah":21,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5644,"text":"22. pour un délai déjà fixé ?","numberInSurah":22,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5645,"text":"23. Ainsi l’avons-Nous déterminé, et nul ne le pourra mieux que Nous !","numberInSurah":23,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5646,"text":"24. Malheur, ce jour-là, aux négateurs !","numberInSurah":24,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5647,"text":"25. N’avons-Nous pas fait de la terre un réceptacle commun","numberInSurah":25,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5648,"text":"26. aux vivants et aux morts ?","numberInSurah":26,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5649,"text":"27. N’y avons-Nous pas implanté des montagnes altières ? Ne vous avons-Nous pas donné à boire une eau très douce ?","numberInSurah":27,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5650,"text":"28. Malheur, ce jour-là, aux négateurs !","numberInSurah":28,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5651,"text":"29. Précipitez-vous donc vers ce que vous teniez pour mensonge !","numberInSurah":29,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5652,"text":"30. Élancez-vous vers l’ombre aux trois colonnes de (la fumée de l’Enfer),","numberInSurah":30,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5653,"text":"31. qui ne protège ni ne prémunit contre les flammes.","numberInSurah":31,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5654,"text":"32. Car (le Feu de la Géhenne) projette des étincelles aussi grandes que de hautes citadelles,","numberInSurah":32,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5655,"text":"33. ou semblables à des chameaux jaunes.","numberInSurah":33,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5656,"text":"34. Malheur, ce jour-là, aux négateurs !","numberInSurah":34,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5657,"text":"35. Ce jour-là, (les mécréants) ne pourront ni parler,","numberInSurah":35,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5658,"text":"36. ni ne seront autorisés à présenter des excuses.","numberInSurah":36,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5659,"text":"37. Malheur, ce jour-là, aux négateurs !","numberInSurah":37,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5660,"text":"38. Voici venu le Jour de la Décision où Nous vous réunissons avec ceux qui vous ont précédés.","numberInSurah":38,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5661,"text":"39. Si vous avez quelque stratagème faites-en donc usage contre Moi !","numberInSurah":39,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5662,"text":"40. Malheur, ce jour-là, aux négateurs !","numberInSurah":40,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5663,"text":"41. Ceux qui sont pieux seront au milieu d’ombrages et de sources (vives),","numberInSurah":41,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5664,"text":"42. et auront les fruits qu’ils désireront.","numberInSurah":42,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5665,"text":"43. « Mangez et buvez en paix pour tout ce que vous faisiez. »","numberInSurah":43,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5666,"text":"44. C’est ainsi que Nous rétribuons les bienfaiteurs.","numberInSurah":44,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5667,"text":"45. Malheur, ce jour-là, aux négateurs !","numberInSurah":45,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5668,"text":"46. « Mangez et jouissez pour peu de temps (ô mécréants), vous êtes certes des scélérats ! »","numberInSurah":46,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5669,"text":"47. Malheur, ce jour-là, aux négateurs !","numberInSurah":47,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5670,"text":"48. Quand il leur est dit : « Inclinez-vous (pour la Çalât) », ils ne s’inclinent pas.","numberInSurah":48,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5671,"text":"49. Malheur, ce jour-là, aux négateurs !","numberInSurah":49,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null},{"number":5672,"text":"50. En quelle parole, après celle-là, vont-ils donc croire ?","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor Inte