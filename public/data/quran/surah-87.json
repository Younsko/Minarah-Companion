[{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"(1) Exalt the name of your Lord, the Most High,","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5950,"text":"(2) Who created and proportioned","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5951,"text":"(3) And who destined and [then] guided","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5952,"text":"(4) And who brings out the pasture","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5953,"text":"(5) And [then] makes it black stubble.","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5954,"text":"(6) We will make you recite, [O Muḥammad], and you will not forget,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5955,"text":"(7) Except what Allāh should will. Indeed, He knows what is declared and what is hidden.","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5956,"text":"(8) And We will ease you toward ease.[1907]","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":"[1907]- To the path of Allāh's religion, which is easy and natural, or toward Paradise, by giving opportunities for righteous deeds."},{"number":5957,"text":"(9) So remind, if the reminder should benefit;[1908]","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":"[1908]- i.e., wherever it will be heard and understood."},{"number":5958,"text":"(10) He who fears [Allāh] will be reminded.","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5959,"text":"(11) But the wretched one will avoid it –","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5960,"text":"(12) [He] who will [enter and] burn in the greatest Fire,","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5961,"text":"(13) Neither dying therein nor living.","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5962,"text":"(14) He has certainly succeeded who purifies himself","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5963,"text":"(15) And mentions the name of his Lord and prays.","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5964,"text":"(16) But you prefer the worldly life,","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5965,"text":"(17) While the Hereafter is better and more enduring.","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5966,"text":"(18) Indeed, this is in the former scriptures,","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5967,"text":"(19) The scriptures of Abraham and Moses.","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"1. Rends gloire au nom de ton Seigneur, le Plus Haut !","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5950,"text":"2. Celui Qui crée et façonne,","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5951,"text":"3. Celui Qui prédestine et guide,","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5952,"text":"4. Celui Qui fait pousser les pâturages,","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5953,"text":"5. pour en faire ensuite une herbe sombre et desséchée.","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5954,"text":"6. Nous te ferons lire (le Coran) dont tu n’oublieras rien,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5955,"text":"7. sauf ce qu’Allah voudra (que tu oublies), car Il Sait ce qui se manifeste au grand jour et ce qui reste caché.","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5956,"text":"8. Nous te mettrons sur la voie la plus facile.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5957,"text":"9. Rappelle donc ! Pour peu que le Rappel soit vraiment utile.","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5958,"text":"10. S’en souviendra sûrement celui qui craint (Allah).","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5959,"text":"11. Et le plus malheureux fera tout pour l’éviter,","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5960,"text":"12. lui qui brûlera dans le Feu le plus grand,","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5961,"text":"13. puis n’y mourra point, pas plus qu’il n’y vivra.","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5962,"text":"14. Aura la réussite celui qui s’est purifié,","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5963,"text":"15. a évoqué le nom de son Seigneur et a prié.","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5964,"text":"16. Vous préférez plutôt la vie en ce bas monde,","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5965,"text":"17. alors que l’autre monde est bien meilleur et autrement durable.","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5966,"text":"18. Cela est (consigné) dans les anciens Feuillets,","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null},{"number":5967,"text":"19. les Feuillets d’Abraham et de Moïse.","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"Sabbihisma Rabbikal A'laa","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"Allazee khalaqa fasawwaa","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"Wallazee qaddara fahadaa","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"Wallazeee akhrajal mar'aa","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"Faja'alahoo ghusaaa'an ahwaa","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"Sanuqri'uka falaa tansaaa","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"Wa nu-yassiruka lilyusraa","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"Fazakkir in nafa'atizzikraa","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"Sa yazzakkaru maiyakhshaa","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"Wa yatajannabuhal ashqaa","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"Allazee yaslan Naaral kubraa","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"Summa laa yamootu feehaa wa laa yahyaa","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"Qad aflaha man tazakkaa","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"Wa zakaras ma Rabbihee fasallaa","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"Bal tu'siroonal hayaatad dunyaa","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"Wal Aakhiratu khairunw wa abqaa","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"Inna haazaa lafis suhu fil oolaa","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"Suhufi Ibraaheema wa Moosaa","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
