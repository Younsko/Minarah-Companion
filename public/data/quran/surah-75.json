[{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"وَخَسَفَ ٱلْقَمَرُ","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"كَلَّا لَا وَزَرَ","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"وَتَذَرُونَ ٱلْءَاخِرَةَ","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌۭ","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"وَقِيلَ مَنْ ۜ رَاقٍۢ","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5586,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5587,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5588,"text":"أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5589,"text":"ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"(1) I swear by the Day of Resurrection","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5553,"text":"(2) And I swear by the reproaching soul[1800] [to the certainty of resurrection].","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1800]- i.e., that of the believer, which blames him when he falls into sin or error."},{"number":5554,"text":"(3) Does man think that We will not assemble his bones?","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5555,"text":"(4) Yes. [We are] Able [even] to proportion his fingertips.","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5556,"text":"(5) But man desires to continue in sin.[1801]","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1801]- Literally, \"to sin ahead of him.\" This refers to the disbeliever, who denies the Day of Account."},{"number":5557,"text":"(6) He asks, \"When is the Day of Resurrection?\"","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5558,"text":"(7) So when vision is dazzled","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5559,"text":"(8) And the moon darkens","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5560,"text":"(9) And the sun and the moon are joined,","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5561,"text":"(10) Man will say on that Day, \"Where is the [place of] escape?\"","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5562,"text":"(11) No! There is no refuge.","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5563,"text":"(12) To your Lord, that Day, is the [place of] permanence.","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5564,"text":"(13) Man will be informed that Day of what he sent ahead[1802] and kept back.[1803]","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1802]- i.e., his deeds, which await him in the Hereafter.\n[1803]- i.e., that which he did not do or which he delayed."},{"number":5565,"text":"(14) Rather, man, against himself, will be a witness,[1804]","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1804]- As described in 36:65 and 41:20-23."},{"number":5566,"text":"(15) Even if he presents his excuses.","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5567,"text":"(16) Move not your tongue with it, [O Muḥammad], to hasten with it [i.e., recitation of the Qur’ān].","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5568,"text":"(17) Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5569,"text":"(18) So when We have recited it [through Gabriel], then follow its recitation.","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5570,"text":"(19) Then upon Us is its clarification [to you].","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5571,"text":"(20) No! But you [i.e., mankind] love the immediate","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5572,"text":"(21) And leave [i.e., neglect] the Hereafter.","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5573,"text":"(22) [Some] faces, that Day, will be radiant,","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5574,"text":"(23) Looking at their Lord.[1805]","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1805]- The people of Paradise will actually see their Creator in the Hereafter."},{"number":5575,"text":"(24) And [some] faces, that Day, will be contorted,","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5576,"text":"(25) Expecting that there will be done to them [something] backbreaking.","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5577,"text":"(26) No! When it [i.e., the soul] has reached the collar bones[1806]","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1806]- At the time it is about to leave the body when one is on the verge of death."},{"number":5578,"text":"(27) And it is said, \"Who will cure [him]?\"","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5579,"text":"(28) And he [i.e., the dying one] is certain that it is the [time of] separation","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5580,"text":"(29) And the leg is wound about the leg,[1807]","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1807]- From the difficulties the person faces at death or his sudden awareness of the realities of both this world and the Hereafter. It may also refer to his shrouding after death."},{"number":5581,"text":"(30) To your Lord, that Day, will be the procession.[1808]","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[1808]- Literally, \"driving\" or \"herding\" or \"the place to which one is driven.\""},{"number":5582,"text":"(31) And he [i.e., the disbeliever] had not believed, nor had he prayed.","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5583,"text":"(32) But [instead], he denied and turned away.","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5584,"text":"(33) And then he went to his people, swaggering [in pride].","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5585,"text":"(34) Woe to you, and woe!","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5586,"text":"(35) Then woe to you, and woe!","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5587,"text":"(36) Does man think that he will be left neglected?[1809]","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":"[1809]- i.e., to no end, without responsibility, or without being returned to the Creator for judgement."},{"number":5588,"text":"(37) Had he not been a sperm from semen emitted?","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5589,"text":"(38) Then he was a clinging clot, and [Allāh] created [his form] and proportioned [him]","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5590,"text":"(39) And made of him two mates, the male and the female.","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5591,"text":"(40) Is not that [Creator] Able to give life to the dead?","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"1. J’en jure par le Jour de la Résurrection !","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5553,"text":"2. J’en jure par l’âme prompte à se blâmer !","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5554,"text":"3. L’homme s’imagine-t-il que Nous ne rassemblerons pas ses os ?","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5555,"text":"4. Que si ! Nous sommes Capable même de reconstituer tel quel le bout de ses doigts.[587]","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[587] De toutes les parties du corps, Allah cite ici le bout des doigts comme étant les plus difficiles à refaire. Pourquoi ? L’allusion aux empreintes digitales est évidente. La science contemporaine a démontré que même le clonage ne donnerait pas des empreintes digitales identiques."},{"number":5556,"text":"5. L’homme préfèrerait poursuivre sa vie en rebelle et pervers.","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5557,"text":"6. Il demande : « À quand donc le Jour de la Résurrection ? »","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5558,"text":"7. Puis lorsque l’œil sera hagard,","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5559,"text":"8. et que la lune se sera éclipsée,","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5560,"text":"9. et que le soleil et la lune auront été réunis,","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5561,"text":"10. l’homme dira, ce jour-là : « Où fuir ? »","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5562,"text":"11. Non ! Il n’y aura point d’issue.","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5563,"text":"12. C’est vers ton Seigneur que, ce jour-là, sera l’aboutissement.","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5564,"text":"13. Et ce jour-là, l’homme sera informé de ce qu’il aura avancé (comme acte) et de ce qu’il aura renvoyé à plus tard.","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5565,"text":"14. L’homme se dressera plutôt contre lui-même en témoin oculaire,","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5566,"text":"15. quand bien même il invoquerait ses excuses.","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5567,"text":"16. Ne le[588] tourne pas (plusieurs fois) dans ta langue, pressé que tu es de le retenir.","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":"[588] Le Coran. La parole est ici adressée à Muhammad (paix et bénédiction d’Allah sur lui)."},{"number":5568,"text":"17. C’est à Nous qu’il appartient de le rassembler (dans ton cœur et ta mémoire) et de te le faire lire.","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5569,"text":"18. Lorsque Nous le lisons, suis-en la lecture.","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5570,"text":"19. Puis il Nous appartient de l’expliquer.","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5571,"text":"20. Non, vous aimez plutôt la vie fugace.","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5572,"text":"21. Et vous négligez la vie de l’autre monde.","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5573,"text":"22. Ce jour-là, des visages seront épanouis,","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5574,"text":"23. qui contempleront leur Seigneur.","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5575,"text":"24. Et ce jour-là, (d’autres) visages seront livides,","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5576,"text":"25. S’attendant à courir un terrible péril.","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5577,"text":"26. Non ! Quand (l’âme à l’agonie) aura atteint les clavicules,","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5578,"text":"27. et qu’il sera demandé : « Quel exorciste (peut la sauver) ? »","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5579,"text":"28. et que (l’agonisant) aura réalisé que le moment de la séparation est arrivé,","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5580,"text":"29. et que ses deux jambes se seront croisées,","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5581,"text":"30. C’est vers ton Seigneur, alors, qu’il sera acheminé.","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5582,"text":"31. Il n’a ni cru ni prié,","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5583,"text":"32. mais il a nié (le Message) et s’est détourné de la foi.","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5584,"text":"33. Puis il s’en est allé, fier et heureux, vers sa famille.","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5585,"text":"34. «Malheur à toi, sur malheur !","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5586,"text":"35. Puis malheur à toi, sur malheur ! »","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5587,"text":"36. L’homme s’imagine-il qu’il n’aura pas de compte à rendre ?","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5588,"text":"37. N’a-t-il pas été une simple goutte de sperme éjaculé,","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5589,"text":"38. puis une petite masse de sang coagulé qu’Allah a, par la suite, créée et façonnée ?","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5590,"text":"39. Il en a fait alors le couple : le mâle et la femelle.","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null},{"number":5591,"text":"40. Celui (Qui a pu faire cela) ne serait-il pas Capable de faire revivre les morts ?","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"Laaa uqsimu bi yawmil qiyaamah","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"Wa laaa uqsimu bin nafsil lawwaamah","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"Ayahsabul insaanu al lan najm'a 'izaamah","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"Balaa qaadireena 'alaaa an nusawwiya banaanah","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"Bal yureedul insaanu liyafjura amaamah","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"Yas'alu ayyyaana yawmul qiyaamah","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"Fa izaa bariqal basar","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"We khasafal qamar","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"Wa jumi'ash shamusu wal qamar","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"Yaqoolul insaanu yaw ma 'izin aynal mafarr","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"Kallaa laa wazar","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"Ilaa rabbika yawma 'izinil mustaqarr","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"Yunabba 'ul insaanu yawma 'izim bimaa qaddama wa akhkhar","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"Balil insaanu 'alaa nafsihee baseerah","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"Wa law alqaa ma'aazeerah","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"Laa tuharrik bihee lisaa naka lita'jala bih","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"Inna 'alainaa jam'ahoo wa qur aanah","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"Fa izaa qaraanaahu fattabi' qur aanah","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"Summa inna 'alainaa bayaanah","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"Kallaa bal tuhibboonal 'aajilah","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"Wa tazaroonal Aakhirah","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"Wujoohuny yawma 'izin naadirah","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"Ilaa rabbihaa naazirah","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"Wa wujoohuny yawma 'izim baasirah","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"Tazunnu any yuf'ala bihaa faaqirah","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"Kallaaa izaa balaghatit taraaqee","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"Wa qeela man raaq","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"Wa zanna annahul firaaq","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"Waltaffatis saaqu bissaaq","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"Ilaa rabbika yawma'izinil masaaq","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"Falaa saddaqa wa laa sallaa","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"Wa laakin kazzaba wa tawalla","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"Summa zahaba ilaaa ahlihee yatamatta","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"Awlaa laka fa awlaa","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5586,"text":"Summa awlaa laka fa awla","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5587,"text":"Ayahsabul insaanu anyytraka sudaa","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5588,"text":"Alam yaku nutfatam mim maniyyiny yumnaa","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5589,"text":"Summa kaana 'alaqata fakhalaq fasawwaa","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"Faja'ala minhuz zawjayniz zakara wal unsaa","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"Alaisa zaalika biqaadirin 'alaaa any yuhyiyal mawtaa","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
