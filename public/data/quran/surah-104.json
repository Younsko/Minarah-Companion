[{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"(1) Woe to every scorner and mocker","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6181,"text":"(2) Who collects wealth and [continuously] counts it.[1987]","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":"[1987]- Rather than spending in the way of Allāh."},{"number":6182,"text":"(3) He thinks that his wealth will make him immortal.","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6183,"text":"(4) No! He will surely be thrown into the Crusher.[1988]","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":"[1988]- i.e., Hellfire, which crushes and destroys all that enters it."},{"number":6184,"text":"(5) And what can make you know what is the Crusher?","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6185,"text":"(6) It is the fire of Allāh, [eternally] fueled,","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6186,"text":"(7) Which mounts directed at the hearts.[1989]","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":"[1989]- Covering them and penetrating them."},{"number":6187,"text":"(8) Indeed, it [i.e., Hellfire] will be closed down upon them","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6188,"text":"(9) In extended columns.[1990]","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":"[1990]- Interpreted to be either columns of fire or columns of iron to which are chained the inmates of Hell."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"1. Malheur à tout calomniateur, diffamateur,","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6181,"text":"2. qui amasse les biens et ne laisse pas de les compter,","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6182,"text":"3. pensant que ses biens le rendront éternel.","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6183,"text":"4. Que non ! Il sera précipité dans la Ḥutamah. [618]","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":"[618] Du trilitère arabe « ḥatama » : détruire, briser. La Ḥutamah est l’un des noms de l’Enfer : tout ce qui y est précipité est, justement, brisé."},{"number":6184,"text":"5. Et qui te fera jamais savoir ce qu’est la Ḥutamah ?","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6185,"text":"6. C’est le Feu d’Allah, à jamais attisé,","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6186,"text":"7. qui atteindra les cœurs.","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6187,"text":"8. Sur eux il se refermera","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6188,"text":"9. et s’étendra par colonnes.","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Al-Humaza","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"Wai lul-li kulli hu mazatil-lumaza","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"Al-lazi jama'a maalaw wa'addadah","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"Yahsabu anna maalahu akhladah","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"Kalla layum ba zanna fil hutamah","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"Wa maa adraaka mal-hutamah","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"Narul laahil-mooqada","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"Al latee tat tali'u 'alalafidah","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"Innaha 'alaihim moosada","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"Fee 'amadim-mu mad dadah","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
