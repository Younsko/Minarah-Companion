[{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5673,"text":"عَمَّ يَتَسَآءَلُونَ","numberInSurah":1,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5674,"text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","numberInSurah":2,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5675,"text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","numberInSurah":3,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5676,"text":"كَلَّا سَيَعْلَمُونَ","numberInSurah":4,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5677,"text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","numberInSurah":5,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5678,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا","numberInSurah":6,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5679,"text":"وَٱلْجِبَالَ أَوْتَادًۭا","numberInSurah":7,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5680,"text":"وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا","numberInSurah":8,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5681,"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا","numberInSurah":9,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5682,"text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا","numberInSurah":10,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5683,"text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا","numberInSurah":11,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5684,"text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا","numberInSurah":12,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5685,"text":"وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا","numberInSurah":13,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5686,"text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا","numberInSurah":14,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5687,"text":"لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا","numberInSurah":15,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5688,"text":"وَجَنَّٰتٍ أَلْفَافًا","numberInSurah":16,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5689,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا","numberInSurah":17,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5690,"text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا","numberInSurah":18,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5691,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا","numberInSurah":19,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5692,"text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","numberInSurah":20,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5693,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5694,"text":"لِّلطَّٰغِينَ مَـَٔابًۭا","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5695,"text":"لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5696,"text":"لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5697,"text":"إِلَّا حَمِيمًۭا وَغَسَّاقًۭا","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5698,"text":"جَزَآءًۭ وِفَاقًا","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5699,"text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5700,"text":"وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5701,"text":"وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5702,"text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5703,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5704,"text":"حَدَآئِقَ وَأَعْنَٰبًۭا","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5705,"text":"وَكَوَاعِبَ أَتْرَابًۭا","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5706,"text":"وَكَأْسًۭا دِهَاقًۭا","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5707,"text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5708,"text":"جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5709,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5710,"text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5711,"text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5712,"text":"إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5673,"text":"(1) About what are they asking one another?","numberInSurah":1,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5674,"text":"(2) About the great news[1821] -","numberInSurah":2,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":"[1821]- i.e., the Resurrection."},{"number":5675,"text":"(3) That over which they are in disagreement.","numberInSurah":3,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5676,"text":"(4) No! They are going to know.","numberInSurah":4,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5677,"text":"(5) Then, no! They are going to know.","numberInSurah":5,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5678,"text":"(6) Have We not made the earth a resting place?","numberInSurah":6,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5679,"text":"(7) And the mountains as stakes?[1822]","numberInSurah":7,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":"[1822]- To stabilize the land and balance the earth."},{"number":5680,"text":"(8) And We created you in pairs","numberInSurah":8,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5681,"text":"(9) And made your sleep [a means for] rest","numberInSurah":9,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5682,"text":"(10) And made the night as clothing[1823]","numberInSurah":10,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":"[1823]- Covering you in darkness and providing rest."},{"number":5683,"text":"(11) And made the day for livelihood","numberInSurah":11,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5684,"text":"(12) And constructed above you seven strong [heavens]","numberInSurah":12,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5685,"text":"(13) And made [therein] a burning lamp","numberInSurah":13,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5686,"text":"(14) And sent down from the rain clouds pouring water","numberInSurah":14,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5687,"text":"(15) That We may bring forth thereby grain and vegetation","numberInSurah":15,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5688,"text":"(16) And gardens of entwined growth.","numberInSurah":16,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5689,"text":"(17) Indeed, the Day of Judgement is an appointed time -","numberInSurah":17,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5690,"text":"(18) The Day the Horn is blown and you will come forth in multitudes","numberInSurah":18,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5691,"text":"(19) And the heaven is opened and will become gateways","numberInSurah":19,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5692,"text":"(20) And the mountains are removed and will be [but] a mirage.","numberInSurah":20,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5693,"text":"(21) Indeed, Hell has been lying in wait","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5694,"text":"(22) For the transgressors, a place of return,","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5695,"text":"(23) In which they will remain for ages [unending].","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5696,"text":"(24) They will not taste therein [any] coolness or drink.","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5697,"text":"(25) Except scalding water and [foul] purulence -","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5698,"text":"(26) An appropriate recompense.[1824]","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":"[1824]- In proportion to and comparable with their crimes."},{"number":5699,"text":"(27) Indeed, they were not expecting an account","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5700,"text":"(28) And denied Our verses with [emphatic] denial.","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5701,"text":"(29) But all things We have enumerated in writing.","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5702,"text":"(30) \"So taste [the penalty], and never will We increase you except in torment.\"[1825]","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":"[1825]- This announcement will be made to the companions of Hell."},{"number":5703,"text":"(31) Indeed, for the righteous is attainment[1826] -","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":"[1826]- Of security, success and reward, including escape and safety from Hell."},{"number":5704,"text":"(32) Gardens and grapevines","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5705,"text":"(33) And young women [companions] of equal age.","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5706,"text":"(34) And a full cup.[1827]","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":"[1827]- Of wine which is delicious and does not intoxicate."},{"number":5707,"text":"(35) No ill speech will they hear therein or any falsehood -","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5708,"text":"(36) [As] reward from your Lord, [a generous] gift [made due by] account,[1828]","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":"[1828]- i.e., as a result of both their own righteous deeds and the limitless generosity of Allāh (subḥānahu wa taʿālā) . Another meaning is \"a gift calculated [to be adequate].\""},{"number":5709,"text":"(37) [From] the Lord of the heavens and the earth and whatever is between them, the Most Merciful. They possess not from Him [authority for] speech.[1829]","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":"[1829]- None of Allāh's creatures can plead with Him on the Day of Judgement except by His permission."},{"number":5710,"text":"(38) The Day that the Spirit [i.e., Gabriel] and the angels will stand in rows, they will not speak except for one whom the Most Merciful permits, and he will say what is correct.","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5711,"text":"(39) That is the True [i.e., certain] Day; so he who wills may take to his Lord a [way of] return.[1830]","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":"[1830]- i.e., a direct route through correct beliefs and righteous deeds."},{"number":5712,"text":"(40) Indeed, We have warned you of an impending punishment on the Day when a man will observe what his hands have put forth[1831] and the disbeliever will say, \"Oh, I wish that I were dust!\"","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":"[1831]- i.e., the deeds he did in this world, which await him in the Hereafter."}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5673,"text":"1. À propos de quoi s’interrogent-ils les uns les autres ?","numberInSurah":1,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5674,"text":"2. C’est à propos de la grande nouvelle,","numberInSurah":2,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5675,"text":"3. qui les a mis en désaccord.","numberInSurah":3,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5676,"text":"4. Non, ils sauront bientôt,","numberInSurah":4,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5677,"text":"5. Que non, ils sauront bientôt.","numberInSurah":5,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5678,"text":"6. N’avons-Nous pas étendu la terre telle une couche ?","numberInSurah":6,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5679,"text":"7. et fait des montagnes des piquets ?","numberInSurah":7,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5680,"text":"8. Nous vous avons créés en couples,","numberInSurah":8,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5681,"text":"9. et avons fait que votre sommeil soit un repos.","numberInSurah":9,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5682,"text":"10. Nous avons fait de la nuit un habit,","numberInSurah":10,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5683,"text":"11. et du jour un moment propice aux occupations vitales.","numberInSurah":11,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5684,"text":"12. Nous avons bâti au-dessus de vous sept (cieux) impressionnants,","numberInSurah":12,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5685,"text":"13. et y avons mis un flambeau à l’ardente lumière.","numberInSurah":13,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5686,"text":"14. Des nuages (gorgés de pluie), Nous avons fait descendre une eau en abondance,","numberInSurah":14,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5687,"text":"15. par laquelle Nous faisons pousser des graines, des plantes,","numberInSurah":15,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5688,"text":"16. et des jardins très denses.","numberInSurah":16,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5689,"text":"17. Le Jour de la Décision est une échéance déjà fixée.","numberInSurah":17,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5690,"text":"18. (C’est) le jour où il sera soufflé dans le Cor et où vous viendrez en foules.","numberInSurah":18,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5691,"text":"19. Le ciel sera alors ouvert, béant de toutes ses portes.","numberInSurah":19,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5692,"text":"20. Les montagnes seront mises en mouvement et ne seront plus que mirages.","numberInSurah":20,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5693,"text":"21. La Géhenne guettera,","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5694,"text":"22. (ultime) refuge pour les rebelles,","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5695,"text":"23. qui y demeureront des ères infinies.","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5696,"text":"24. Ils n’y goûteront ni fraîcheur ni boisson,","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5697,"text":"25. autre qu’eau bouillante et purulence,","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5698,"text":"26. en juste rétribution (pour ce qu’ils auront fait).","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5699,"text":"27. Ils ne prévoyaient nullement qu’ils auraient des comptes à rendre,","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5700,"text":"28. et ils traitaient obstinément Nos versets de mensonges.","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5701,"text":"29. Nous avons pourtant tout recensé en un Livre.","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5702,"text":"30. Goûtez donc, Nous ne ferons qu’ajouter à votre supplice !","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5703,"text":"31. Ceux qui sont pieux atteindront certes au succès suprême.","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5704,"text":"32. (Il y aura pour eux) des jardins et des vignes,","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5705,"text":"33. des femmes jeunes aux seins fermes et toutes du même âge,","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5706,"text":"34. des coupes pleines (de boissons) débordantes.","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5707,"text":"35. Ils n’y entendront ni vains propos ni mensonges.","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5708,"text":"36. Telle est la récompense de ton Seigneur : don prodigue et généreux !","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5709,"text":"37. Seigneur des cieux, de la terre et de ce qui est entre eux, le Tout Clément à Qui ils ne pourront adresser aucune parole.","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5710,"text":"38. (Ce sera) le jour où l’Esprit et les Anges se tiendront en rangées, ne disant mot, sauf ceux à qui le Tout Clément permettra (de parler) et dont la parole sera vérité.","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5711,"text":"39. Tel sera le Vrai jour ! Prenne donc refuge auprès de son Seigneur celui qui le voudra.","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null},{"number":5712,"text":"40. Nous vous avons mis en garde contre un supplice tout proche. Ce jour-là l’homme verra ce qu’il aura fait de ses propres mains, et le mécréant dira : « Ah ! si seulement j’étais poussière ! »","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":78,"name":"سُورَةُ النَّبَإِ","englishName":"An-Naba","englishNameTranslation":"The Announcement","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5673,"text":"'Amma Yatasaa-aloon","numberInSurah":1,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5674,"text":"'Anin-nabaa-il 'azeem","numberInSurah":2,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5675,"text":"Allazi hum feehi mukh talifoon","numberInSurah":3,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5676,"text":"Kallaa sa y'alamoon","numberInSurah":4,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5677,"text":"Thumma kallaa sa y'alamoon","numberInSurah":5,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5678,"text":"Alam naj'alil arda mihaa da","numberInSurah":6,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5679,"text":"Wal jibaala au taada","numberInSurah":7,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5680,"text":"Wa khalaq naakum azwaaja","numberInSurah":8,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5681,"text":"Waja'alnan naumakum subata","numberInSurah":9,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5682,"text":"Waja'alnal laila libasa","numberInSurah":10,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5683,"text":"Waja'alnan nahara ma 'aasha","numberInSurah":11,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5684,"text":"Wa banaina fauqakum sab 'an shi daada","numberInSurah":12,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5685,"text":"Waja'alna siraajaw wah haaja","numberInSurah":13,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5686,"text":"Wa anzalna minal m'usiraati maa-an saj-jaaja","numberInSurah":14,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5687,"text":"Linukh rija bihee habbaw wana baata","numberInSurah":15,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5688,"text":"Wa jan naatin alfafa","numberInSurah":16,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5689,"text":"Inna yaumal-fasli kana miqaata","numberInSurah":17,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5690,"text":"Yauma yun fakhu fis-soori fataa toona afwaaja","numberInSurah":18,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5691,"text":"Wa futiha tis samaa-u fakaanat abwaaba","numberInSurah":19,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5692,"text":"Wa suyyi raatil jibaalu fa kaanat saraaba","numberInSurah":20,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5693,"text":"Inna jahan nama kaanat mirsaada","numberInSurah":21,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5694,"text":"Lit taa gheena ma aaba","numberInSurah":22,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5695,"text":"Laa bitheena feehaa ahqaaba","numberInSurah":23,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5696,"text":"Laa ya zooqoona feeha bar daw walaa sharaaba","numberInSurah":24,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5697,"text":"Illa hamee maw-wa ghas saaqa","numberInSurah":25,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5698,"text":"Jazaa-aw wi faaqa","numberInSurah":26,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5699,"text":"Innahum kaanu laa yarjoona hisaaba","numberInSurah":27,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5700,"text":"Wa kazzabu bi aayaa tina kizzaba","numberInSurah":28,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5701,"text":"Wa kulla shai-in ahsai naahu kitaa ba","numberInSurah":29,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5702,"text":"Fa zooqoo falan-nazee dakum ill-laa azaaba","numberInSurah":30,"juz":30,"manzil":7,"page":582,"ruku":518,"hizbQuarter":233,"sajda":false},{"number":5703,"text":"Inna lil mutta qeena mafaaza","numberInSurah":31,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5704,"text":"Hadaa-iqa wa a'anaa ba","numberInSurah":32,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5705,"text":"Wa kaawa 'iba at raaba","numberInSurah":33,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5706,"text":"Wa ka'san di haaqa","numberInSurah":34,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5707,"text":"Laa yasma'oona fiha lagh waw walaa kizzaba","numberInSurah":35,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5708,"text":"Jazaa-am mir-rabbika ataa-an hisaaba","numberInSurah":36,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5709,"text":"Rabbis samaa waati wal ardi wa maa baina humar rahmaani laa yam likoona minhu khi taaba","numberInSurah":37,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5710,"text":"Yauma yaqoo mur roohu wal malaa-ikatu saf-fal laa yata kalla moona illa man azina lahur rahmaanu wa qaala sawaaba","numberInSurah":38,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5711,"text":"Zaalikal yaumul haqqu faman shaa-at ta khaaza ill-laa rabbihi ma-aaba","numberInSurah":39,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false},{"number":5712,"text":"In naa anzar naakum azaaban qareebaiy-yauma yan zurul marr-u maa qaddamat yadaahu wa ya qoolul-kaafiru yaa lai tanee kuntu turaaba","numberInSurah":40,"juz":30,"manzil":7,"page":583,"ruku":519,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"en.transliteration","language":"en","name":"Transliteration","englishName":"English Transliteration","format":"text","type":"transliteration","direction":"ltr"}}]
