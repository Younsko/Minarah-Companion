[{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"مِن شَرِّ مَا خَلَقَ","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"(1) Say, \"I seek refuge in the Lord of daybreak","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6227,"text":"(2) From the evil of that which He created","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6228,"text":"(3) And from the evil of darkness when it settles","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6229,"text":"(4) And from the evil of the blowers in knots[2014]","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":"[2014]- i.e., those who practice magic."},{"number":6230,"text":"(5) And from the evil of an envier when he envies.\"","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"english_saheeh","language":"en","name":"English Translation - Noor International Center","englishName":"English Translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.1.2","sourceUrl":"https://quranenc.com/en/home/api"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"1. Dis : « Je cherche refuge auprès du Seigneur de l’aube naissante,","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6227,"text":"2. contre le mal de ce qu’Il a créé,","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6228,"text":"3. contre le mal de l’obscurité quand elle devient ténèbres,","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6229,"text":"4. contre le mal des (sorcières) qui soufflent dans les nœuds,","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null},{"number":6230,"text":"5. et contre le mal de l’envieux quand il envie. »","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false,"footnotes":null}],"edition":{"identifier":"french_montada","language":"fr","name":"French translation - Noor International Center","englishName":"French translation - Noor International Center","format":"text","type":"translation","direction":"ltr","source":"QuranEnc","publisher":"Noor International Center","version":"1.0.0","sourceUrl":"https://quranenc.com/en/h